{
  "name": "oa-auth-broker-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "kv_namespaces": [{ "binding": "BROKER_REGISTRY", "id": "broker-test" }],
  "ratelimits": [
    {
      "name": "RL_BROKER_IP",
      "namespace_id": "1001",
      "simple": { "limit": 1000, "period": 60 }
    },
    {
      "name": "RL_BROKER_INSTALL",
      "namespace_id": "1002",
      "simple": { "limit": 1000, "period": 60 }
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "cid.apps.googleusercontent.com",
    "GOOGLE_CLIENT_SECRET": "broker-google-secret",
    "BROKER_ORIGIN": "https://auth.hosted.test",
    "BROKER_STATE_KEY": "broker-state-key-0123456789abcdef0123"
  }
}
