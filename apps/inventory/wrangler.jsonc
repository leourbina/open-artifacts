{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oa-inventory",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // INVENTORY_KEY is a secret (wrangler secret put INVENTORY_KEY), so it is not listed here.
  // PLATFORM_DB is the only binding. database_id is filled at deploy.
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "oa-platform",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
