---
// "Any AI agent, one home": agent tiles send format chips along curved wires
// into the Open Artifacts mark. Pure CSS (offset-path); a tiny script only
// pauses it offscreen. The stage is decorative; the caption says the same.
// Two fixed-size layouts, so the CSS paths match the SVG wires exactly.
const agents = ["Claude Code", "Codex", "Cursor", "OpenCode", "Any MCP client"];
const formats = ["HTML", "MD", "Code", "PDF", "HTML"];

const layout = (w: number, tileW: number, tileH: number, hubTop: number) => {
  const gap = (w - agents.length * tileW) / (agents.length - 1);
  const hx = w / 2;
  return agents.map((_, i) => {
    const x = tileW / 2 + i * (tileW + gap);
    const mid = (tileH + hubTop) / 2;
    return `M${x} ${tileH}C${x} ${mid + 8} ${hx} ${mid - 8} ${hx} ${hubTop}`;
  });
};
// Wide: 720 x 176, hub 52px. Phone: 340 x 150, hub 46px.
const wide = layout(720, 124, 40, 124);
const phone = layout(340, 64, 44, 104);
---

<figure class="wire" data-wire>
  <div class="wire-stage" aria-hidden="true">
    <svg class="wire-lines wide" width="720" height="176" viewBox="0 0 720 176">
      {wide.map((d) => <path d={d} />)}
    </svg>
    <svg class="wire-lines phone" width="340" height="150" viewBox="0 0 340 150">
      {phone.map((d) => <path d={d} />)}
    </svg>
    <ul class="wire-tiles">
      {agents.map((a, i) => <li style={`--i:${i}`}>{a}</li>)}
    </ul>
    {
      formats.map((f, i) => (
        <span class="wire-chip" style={`--i:${i};--pw:path("${wide[i]}");--pp:path("${phone[i]}")`}>
          {f}
        </span>
      ))
    }
    <span class="wire-hub">
      <svg viewBox="0 0 16 16" width="28" height="28">
        <path
          class="f"
          d="M10 0H2.5A2.5 2.5 0 0 0 0 2.5V10l3 3V3h10zM6 16h7.5a2.5 2.5 0 0 0 2.5-2.5V6l-3-3v10H3z"
        ></path>
        <path
          class="a"
          d="M10 0h3.5A2.5 2.5 0 0 1 16 2.5V6zM0 10v3.5A2.5 2.5 0 0 0 2.5 16H6zM6 5h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"
        ></path>
      </svg>
    </span>
  </div>
  <figcaption>
    Any AI agent sends its HTML, Markdown, code and PDFs to one home on your Cloudflare account.
  </figcaption>
</figure>

<style>
  .wire {
    margin: 8px 0 0;
  }
  .wire-stage {
    --w: 340px;
    --h: 150px;
    --tile-w: 64px;
    --tile-h: 44px;
    --hub: 46px;
    --hub-top: 104px;
    position: relative;
    width: var(--w);
    height: var(--h);
    margin: 0 auto;
  }
  @media (min-width: 800px) {
    .wire-stage {
      --w: 720px;
      --h: 176px;
      --tile-w: 124px;
      --tile-h: 40px;
      --hub: 52px;
      --hub-top: 124px;
      margin: 0;
    }
  }
  /* Narrower than 372px: shrink the whole stage, paths included. */
  @media (max-width: 371px) {
    .wire-stage {
      zoom: 0.85;
    }
  }
  .wire-lines {
    position: absolute;
    inset: 0;
    fill: none;
    stroke: var(--oa-border);
    stroke-width: 1.5;
  }
  .wire-chip {
    offset-path: var(--pp);
  }
  .wire-lines.wide {
    display: none;
  }
  @media (min-width: 800px) {
    .wire-lines.wide {
      display: block;
    }
    .wire-lines.phone {
      display: none;
    }
    .wire-chip {
      offset-path: var(--pw);
    }
  }
  .wire-tiles {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wire-tiles li {
    display: grid;
    place-items: center;
    width: var(--tile-w);
    height: var(--tile-h);
    padding: 0 4px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-1);
    color: var(--oa-text);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    animation: wire-glow 10s var(--oa-ease) infinite;
    animation-delay: calc(var(--i) * 2s);
  }
  @media (min-width: 800px) {
    .wire-tiles li {
      font-size: var(--oa-text-sm);
    }
  }
  .wire-chip {
    position: absolute;
    left: 0;
    top: 0;
    offset-rotate: 0deg;
    offset-anchor: center;
    padding: 2px 6px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-accent-soft);
    color: var(--oa-accent-fg);
    font: 500 12px / 1.3 var(--oa-font-mono);
    box-shadow: 0 0 0 1px var(--oa-accent);
    opacity: 0;
    animation: wire-send 10s var(--oa-ease) infinite;
    animation-delay: calc(var(--i) * 2s);
  }
  .wire-hub {
    position: absolute;
    left: calc(50% - var(--hub) / 2);
    top: var(--hub-top);
    display: grid;
    place-items: center;
    width: var(--hub);
    height: var(--hub);
    border-radius: var(--oa-radius-lg);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-2);
    animation: wire-land 2s var(--oa-ease) infinite;
  }
  .wire-hub .f {
    fill: var(--oa-text);
  }
  .wire-hub .a {
    fill: var(--oa-accent);
  }
  .wire figcaption {
    margin-top: 12px;
    color: var(--oa-text-2);
    font-size: var(--oa-text-md);
    text-align: center;
  }
  @media (min-width: 800px) {
    .wire figcaption {
      max-width: 720px;
    }
  }
  /* Each tile owns a 2s slot of the 10s loop: glow, send, land. */
  @keyframes wire-glow {
    0%,
    18%,
    100% {
      box-shadow: var(--oa-shadow-1);
    }
    3%,
    12% {
      box-shadow:
        0 0 0 2px var(--oa-accent),
        0 4px 18px color-mix(in srgb, var(--oa-accent) 35%, transparent);
    }
  }
  @keyframes wire-send {
    0%,
    3% {
      offset-distance: 0%;
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    17% {
      offset-distance: 100%;
      opacity: 1;
    }
    19%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  @keyframes wire-land {
    0%,
    80%,
    100% {
      transform: none;
    }
    88% {
      transform: scale(1.08);
    }
  }
  .wire.paused * {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .wire * {
      animation: none !important;
    }
  }
</style>

<script>
  const wire = document.querySelector<HTMLElement>("[data-wire]");
  if (wire)
    new IntersectionObserver(([e]) => wire.classList.toggle("paused", !e.isIntersecting)).observe(
      wire,
    );
</script>
