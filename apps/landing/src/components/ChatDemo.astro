---
// "Ask in chat. Get a link." A chat asks any AI agent to publish, the tool
// call runs, and the browser opens the artifact, which is real and works.
// Tabs swap the example. With no JS or reduced motion, it shows the final
// frame; the chat text is real text, and the typing copy is aria-hidden.
const PROMPT = "›";
const CHECK = "✓";
const DOT = "·";
const scenes = [
  {
    key: "html",
    tab: "HTML",
    agent: "Claude Code",
    ask: "publish this as an artifact",
    tool: "publish_artifact",
    title: "Calculator",
    id: "7Hq3kP",
  },
  {
    key: "md",
    tab: "Markdown",
    agent: "Codex",
    ask: "publish the migration plan as an artifact",
    tool: "publish_artifact",
    title: "Q4 data migration plan",
    id: "Rm2x9C",
  },
  {
    key: "code",
    tab: "Code",
    agent: "Cursor",
    ask: "publish this script as an artifact",
    tool: "publish_artifact",
    title: "backfill.py",
    id: "c8Vd1Q",
  },
  {
    key: "pdf",
    tab: "PDF",
    agent: "OpenCode",
    ask: "publish the signed contract as an artifact",
    tool: "publish_artifact",
    title: "Vendor agreement.pdf",
    id: "Pf4nW2",
  },
  {
    key: "live",
    tab: "Live data",
    agent: "Claude Code",
    ask: "publish a poll the team can vote in",
    tool: "publish_artifact",
    title: "Offsite location poll",
    id: "L1v3Zt",
  },
  {
    key: "share",
    tab: "Share",
    agent: "Codex",
    ask: "share the plan with maya@ and sam@",
    tool: "share_artifact",
    title: "Q4 data migration plan",
    id: "Rm2x9C",
  },
];
const keys = [
  "7",
  "8",
  "9",
  "÷",
  "4",
  "5",
  "6",
  "×",
  "1",
  "2",
  "3",
  "−",
  "C",
  "0",
  "=",
  "+",
];
const code = [
  ["k", "def "],
  ["f", "backfill"],
  ["", "(conn, batch="],
  ["n", "5000"],
  ["", "):\n    "],
  ["c", "# copy shipped_at in batches, newest first"],
  ["", "\n    "],
  ["k", "for "],
  ["", "ids "],
  ["k", "in "],
  ["", "chunks(pending(conn), batch):\n        conn.execute("],
  ["s", '"UPDATE orders SET shipped_at = ..."'],
  ["", ", ids)\n    "],
  ["k", "return "],
  ["s", '"done"'],
];
const pages = [
  [
    "Vendor agreement",
    "Between Northwind Eng and Acme Data, effective November 1. Acme hosts the warehouse; Northwind owns the data.",
  ],
  [
    "Terms",
    "Twelve months, renewing yearly. Either side may end it with 30 days' notice. Fees are billed monthly.",
  ],
  [
    "Signatures",
    "Signed by Maya Chen for Northwind Eng and by Jordan Lee for Acme Data on October 14.",
  ],
];
const poll = [
  ["Lisbon", 6],
  ["Mexico City", 4],
  ["Montreal", 2],
];
---

<div class="demo-tabs" role="tablist" aria-label="Examples" data-tabs hidden>
  {
    scenes.map((s, i) => (
      <button
        type="button"
        role="tab"
        id={`demo-tab-${s.key}`}
        aria-controls="demo-panel"
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        data-key={s.key}
      >
        {s.tab}
      </button>
    ))
  }
</div>

<div class="demo" id="demo-panel" role="tabpanel" aria-labelledby="demo-tab-html" data-demo>
  <div class="demo-chat">
    <div class="demo-bar"><span class="demo-dot"></span><span data-agent>{scenes[0].agent}</span></div>
    {
      scenes.map((s, i) => (
        <div class="demo-log" data-scene={s.key} hidden={i > 0}>
          <p class="demo-ask">
            <span class="demo-caret" aria-hidden="true">{PROMPT}</span>
            <span class="demo-type">
              <span class="sr-only">{s.ask}</span>
              <span class="demo-ghost" aria-hidden="true">{s.ask}</span>
              <span class="demo-typed" aria-hidden="true" data-typed>{s.ask}</span>
            </span>
          </p>
          <p class="demo-tool" data-at="2">
            <span class="mono">{s.tool}</span> <span class="demo-ok">{CHECK}</span>
          </p>
          <button class="demo-card" type="button" data-at="3" data-open>
            <span class="demo-card-t">{s.title}</span>
            <span class="demo-card-u mono">artifacts.example.com/a/{s.id}</span>
            <span class="demo-card-m">{s.key === "share" ? `Shared ${DOT} 2 people` : `v1 ${DOT} Private`} {DOT} Open</span>
          </button>
        </div>
      ))
    }
    <p class="demo-input" aria-hidden="true">Message <span data-agent-2>{scenes[0].agent}</span></p>
  </div>

  <div class="demo-browser">
    <div class="demo-bar">
      <span class="demo-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="demo-url mono"
        ><span class="sr-only">Address: </span>artifacts.example.com/a/<span data-url
          >{scenes[0].id}</span
        ></span
      >
    </div>
    <div class="demo-art" data-at="4" tabindex="-1" data-art>
      <div data-scene="html" class="art-calc">
        <p class="calc-h">Calculator</p>
        <output class="calc-out mono" data-calc-out aria-live="polite">0</output>
        <div class="calc-keys">
          {
            keys.map((k) => (
              <button type="button" data-k={k} class:list={[{ op: /[^\d]/.test(k) }]}>
                {k}
              </button>
            ))
          }
        </div>
      </div>

      <article data-scene="md" class="art-md" hidden>
        <h3>Q4 data migration plan</h3>
        <p>Move order history from the old Postgres cluster to D1 without downtime.</p>
        <h4>Steps</h4>
        <ol>
          <li><b>Freeze writes</b> on the old tables, Oct 28.</li>
          <li><b>Backfill</b> in batches of 5,000, newest first.</li>
          <li><b>Cut over</b> reads, then writes, Nov 18.</li>
        </ol>
        <h4>Owners</h4>
        <p>Maya runs the backfill; Sam owns the cutover checklist.</p>
      </article>

      <div data-scene="code" class="art-code" hidden>
        <div class="code-bar">
          <span class="mono">backfill.py</span>
          <button type="button" data-copy-code>Copy</button>
        </div>
        <pre class="mono" data-code>{code.map(([t, s]) => (t ? <span class={`t-${t}`}>{s}</span> : s))}</pre>
      </div>

      <div data-scene="pdf" class="art-pdf" hidden>
        <div class="pdf-bar">
          <button type="button" data-pdf="-1">Prev</button>
          <span data-pdf-n aria-live="polite">Page 1 of 3</span>
          <button type="button" data-pdf="1">Next</button>
        </div>
        {
          pages.map(([h, body], i) => (
            <div class="pdf-page" data-page={i} hidden={i > 0}>
              <p class="pdf-h">{h}</p>
              <p>{body}</p>
              <p class="pdf-f mono">{i + 1} / 3</p>
            </div>
          ))
        }
      </div>

      <div data-scene="live" class="art-live" hidden>
        {
          ["You", "Maya, on her laptop"].map((who, pane) => (
            <div class="live-pane">
              <p class="live-who">{who}</p>
              <p class="live-q">Where should we hold the offsite?</p>
              <ul>
                {poll.map(([city, n], i) => (
                  <li>
                    <button type="button" data-vote={i} aria-label={pane ? `${city}, from Maya's view` : undefined}>
                      <span>{city}</span>
                      <span class="mono" data-count={i}>{n}</span>
                      <span class="live-bar" style={`--n:${n}`} data-bar={i}></span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <p class="live-note" data-live-note aria-live="polite">Vote in either pane. Both stay in sync.</p>
      </div>

      <div data-scene="share" class="art-share" hidden>
        <p class="share-h">Share "Q4 data migration plan"</p>
        <ul class="share-people">
          {
            [
              ["MC", "Maya Chen", "Editor"],
              ["SO", "Sam Ortiz", "Viewer"],
            ].map(([ini, name, role]) => (
              <li>
                <span class="share-av" aria-hidden="true">{ini}</span>
                <span class="share-name">{name}</span>
                <select aria-label={`${name}'s access`}>
                  <option selected={role === "Viewer"}>Viewer</option>
                  <option selected={role === "Editor"}>Editor</option>
                </select>
              </li>
            ))
          }
        </ul>
        <p class="share-vis"><span class="badge team">Team</span> Anyone on your team with the link can view.</p>
        <button class="share-copy" type="button" data-copy-link>Copy link</button>
      </div>
    </div>
  </div>
</div>

<style>
  .demo-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }
  .demo-tabs button {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--oa-border);
    border-radius: 999px;
    background: var(--oa-surface);
    color: var(--oa-text-2);
    font: 500 var(--oa-text-sm) var(--oa-font-sans);
    cursor: pointer;
  }
  .demo-tabs [aria-selected="true"] {
    border-color: var(--oa-text);
    background: var(--oa-text);
    color: var(--oa-surface);
  }
  .demo {
    display: grid;
    gap: 12px;
    margin-top: 16px;
    padding: 12px;
    background: var(--oa-chrome);
    border-radius: var(--oa-radius-lg);
    box-shadow: var(--oa-shadow-1);
    font-size: var(--oa-text-sm);
  }
  @media (min-width: 800px) {
    .demo {
      grid-template-columns: 5fr 7fr;
      gap: 20px;
      padding: 20px;
    }
  }
  .demo-chat {
    display: flex;
    flex-direction: column;
  }
  .demo-chat,
  .demo-browser {
    min-width: 0;
    background: var(--oa-surface);
    border-radius: var(--oa-radius-lg);
    box-shadow: var(--oa-shadow-1);
    overflow: hidden;
  }
  .demo-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border-bottom: 1px solid var(--oa-divider);
    color: var(--oa-text-2);
    font-weight: 500;
  }
  .demo-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--oa-success);
  }
  .demo-log {
    display: grid;
    align-content: start;
    gap: 10px;
    flex: 1;
    padding: 12px;
  }
  .demo-input {
    display: none;
    margin: 0 12px 12px;
    padding: 8px 10px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
    color: var(--oa-text-muted);
  }
  @media (min-width: 800px) {
    .demo-input {
      display: block;
    }
  }
  .demo-ask {
    display: flex;
    min-height: calc(3.1em + 16px);
    gap: 8px;
    padding: 8px 10px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-sunken);
    font-family: var(--oa-font-mono);
  }
  @media (min-width: 800px) {
    .demo-ask {
      min-height: 0;
    }
  }
  .demo-caret {
    color: var(--oa-text-muted);
  }
  .demo-type {
    position: relative;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .demo-ghost {
    visibility: hidden;
  }
  .demo-typed {
    position: absolute;
    inset: 0;
  }
  .demo-tool {
    justify-self: start;
    padding: 4px 8px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
  }
  .demo-ok {
    color: var(--oa-success-fg);
    font-weight: 600;
  }
  .demo-card {
    display: grid;
    gap: 2px;
    justify-items: start;
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--oa-border);
    border-left: 3px solid var(--oa-accent);
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    color: var(--oa-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .demo-card:hover {
    border-color: var(--oa-border-strong);
    border-left-color: var(--oa-accent);
  }
  .demo-card-t {
    font-weight: 600;
  }
  .demo-card-u {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--oa-accent-fg);
    font-size: var(--oa-text-xs);
  }
  .demo-card-m {
    color: var(--oa-text-muted);
    font-size: var(--oa-text-xs);
  }
  .demo-dots {
    display: flex;
    gap: 5px;
  }
  .demo-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--oa-border);
  }
  .demo-url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--oa-sunken);
    color: var(--oa-text-2);
    font-size: var(--oa-text-xs);
    font-weight: 400;
  }
  .demo-art {
    height: 320px;
    padding: 16px;
    overflow: auto;
    outline-offset: -2px;
  }
  @media (min-width: 800px) {
    .demo-art {
      height: 340px;
    }
  }

  /* Timeline: JS sets data-step 0 to 4 while it plays. */
  [data-at] {
    transition:
      opacity 320ms var(--oa-ease),
      transform 320ms var(--oa-ease);
  }
  .demo[data-step="0"] [data-at],
  .demo[data-step="1"] [data-at],
  .demo[data-step="2"] [data-at]:not([data-at="2"]),
  .demo[data-step="3"] [data-at="4"] {
    opacity: 0;
    transform: translateY(6px);
  }

  /* HTML: calculator */
  .art-calc {
    display: grid;
    gap: 10px;
    max-width: 280px;
    margin: 0 auto;
  }
  .calc-h {
    font-weight: 600;
  }
  .calc-out {
    padding: 8px 12px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-sunken);
    font-size: 22px;
    text-align: right;
    overflow: hidden;
  }
  .calc-keys {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .calc-keys button,
  .code-bar button,
  .pdf-bar button,
  .share-copy {
    min-height: 36px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    color: var(--oa-text);
    font: 500 var(--oa-text-md) var(--oa-font-sans);
    cursor: pointer;
  }
  .calc-keys button:hover,
  .code-bar button:hover,
  .pdf-bar button:hover {
    border-color: var(--oa-border-strong);
  }
  .calc-keys .op {
    background: var(--oa-accent-soft);
    color: var(--oa-accent-fg);
  }

  /* Markdown */
  .art-md h3 {
    font-size: var(--oa-text-xl);
  }
  .art-md h4 {
    margin: 14px 0 4px;
    font-size: var(--oa-text-md);
  }
  .art-md p,
  .art-md ol {
    margin: 6px 0 0;
    color: var(--oa-text-2);
    font-size: var(--oa-text-md);
  }
  .art-md ol {
    padding-left: 20px;
  }
  .art-md b {
    color: var(--oa-text);
  }

  /* Code */
  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    color: var(--oa-text-muted);
  }
  .code-bar button {
    min-height: 28px;
    padding: 0 10px;
    font-size: var(--oa-text-sm);
  }
  .art-code pre {
    margin: 0;
    padding: 12px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-sunken);
    font-size: 12px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .t-k {
    color: var(--oa-accent-fg);
  }
  .t-f {
    color: var(--oa-text);
    font-weight: 600;
  }
  .t-n {
    color: var(--oa-warning);
  }
  .t-s {
    color: var(--oa-success-fg);
  }
  .t-c {
    color: var(--oa-text-muted);
  }

  /* PDF */
  .art-pdf {
    display: grid;
    gap: 10px;
  }
  .pdf-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--oa-text-2);
  }
  .pdf-bar button {
    min-height: 30px;
    padding: 0 12px;
    font-size: var(--oa-text-sm);
  }
  .pdf-page {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 220px;
    padding: 20px 22px;
    border-radius: 2px;
    background: #fff;
    box-shadow: var(--oa-shadow-2);
    color: #15181c;
    font-family: Georgia, serif;
    font-size: var(--oa-text-md);
  }
  .pdf-h {
    font-size: var(--oa-text-lg);
    font-weight: 600;
  }
  .pdf-f {
    margin-top: auto;
    color: #5f6670;
    font-size: var(--oa-text-xs);
    text-align: center;
  }

  /* Live data */
  .art-live {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .live-pane {
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
  }
  .live-who {
    color: var(--oa-text-muted);
    font-size: var(--oa-text-xs);
  }
  .live-q {
    margin: 2px 0 8px;
    font-weight: 600;
    font-size: var(--oa-text-sm);
  }
  .art-live ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .art-live li button {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 8px;
    width: 100%;
    padding: 6px 8px;
    border: 1px solid var(--oa-divider);
    border-radius: var(--oa-radius-sm);
    background: var(--oa-surface);
    color: var(--oa-text);
    font: inherit;
    font-size: var(--oa-text-xs);
    text-align: left;
    cursor: pointer;
  }
  .art-live li button:hover {
    border-color: var(--oa-border-strong);
  }
  .live-bar {
    grid-column: 1 / -1;
    height: 4px;
    width: calc(var(--n) * 7%);
    max-width: 100%;
    border-radius: 2px;
    background: var(--oa-accent);
    transition: width var(--oa-duration) var(--oa-ease);
  }
  .live-note {
    grid-column: 1 / -1;
    color: var(--oa-text-muted);
    font-size: var(--oa-text-xs);
  }

  /* Share */
  .art-share {
    display: grid;
    gap: 12px;
    max-width: 420px;
  }
  .share-h {
    font-weight: 600;
  }
  .share-people {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .share-people li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .share-av {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--oa-accent-soft);
    color: var(--oa-accent-fg);
    font-size: var(--oa-text-xs);
    font-weight: 600;
  }
  .share-name {
    flex: 1;
  }
  .share-people select {
    min-height: 30px;
    padding: 0 6px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    color: var(--oa-text);
    font: inherit;
  }
  .share-vis {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--oa-text-2);
  }
  .share-copy {
    justify-self: start;
    padding: 0 14px;
    background: var(--oa-text);
    border-color: var(--oa-text);
    color: var(--oa-surface);
  }
</style>

<script>
  const demo = document.querySelector<HTMLElement>("[data-demo]");
  const tabs = document.querySelector<HTMLElement>("[data-tabs]");
  if (demo && tabs) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = demo) =>
      root.querySelector<T>(s);
    const $$ = <T extends Element = HTMLElement>(s: string, root: ParentNode = demo) => [
      ...root.querySelectorAll<T>(s),
    ];
    const tabList = $$<HTMLButtonElement>("[role=tab]", tabs);
    const slugs: Record<string, string> = {};
    for (const log of $$(".demo-log")) {
      const u = $(".demo-card-u", log)?.textContent ?? "";
      slugs[log.dataset.scene ?? ""] = u.slice(u.lastIndexOf("/") + 1);
    }
    const agents = ["Claude Code", "Codex", "Cursor", "OpenCode", "Claude Code", "Codex"];
    const url = $("[data-url]");
    const art = $("[data-art]");
    let run = 0;
    let started = false;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const play = async (key: string) => {
      const id = ++run;
      const live = () => id === run;
      for (const el of $$("[data-scene]")) el.hidden = el.dataset.scene !== key;
      const log = $(`.demo-log[data-scene="${key}"]`);
      const typed = log && $("[data-typed]", log);
      const ghost = log && $(".demo-ghost", log);
      const ask = ghost?.textContent ?? "";
      const slug = slugs[key] ?? "";
      const name = agents[tabList.findIndex((t) => t.dataset.key === key)] ?? "";
      for (const a of $$("[data-agent], [data-agent-2]")) a.textContent = name;
      if (reduce.matches) {
        delete demo.dataset.step;
        if (typed) typed.textContent = ask;
        if (url) url.textContent = slug;
        return;
      }
      demo.dataset.step = "1";
      if (url) url.textContent = "";
      for (let i = 0; i <= ask.length && live(); i += 2) {
        if (typed) typed.textContent = ask.slice(0, i);
        await wait(28);
      }
      if (typed && live()) typed.textContent = ask;
      for (const [step, ms] of [
        ["2", 500],
        ["3", 450],
      ] as const) {
        if (!live()) return;
        demo.dataset.step = step;
        await wait(ms);
      }
      for (let i = 0; i <= slug.length && live(); i++) {
        if (url) url.textContent = slug.slice(0, i);
        await wait(55);
      }
      if (live()) delete demo.dataset.step;
    };

    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabList) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      }
      demo.setAttribute("aria-labelledby", tab.id);
      if (focus) tab.focus();
      void play(tab.dataset.key ?? "html");
    };
    tabs.hidden = false;
    tabs.addEventListener("click", (e) => {
      const t = (e.target as Element).closest<HTMLButtonElement>("[role=tab]");
      if (t) select(t);
    });
    tabs.addEventListener("keydown", (e) => {
      const i = tabList.indexOf(document.activeElement as HTMLButtonElement);
      const n = tabList.length;
      const next = { ArrowRight: i + 1, ArrowLeft: i - 1 + n, Home: 0, End: n - 1 }[e.key];
      if (next === undefined || i < 0) return;
      e.preventDefault();
      select(tabList[next % n], true);
    });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !started) {
        started = true;
        void play("html");
      }
    }).observe(demo);
    for (const b of $$("[data-open]")) b.addEventListener("click", () => art?.focus());

    // Calculator
    const out = $("[data-calc-out]");
    let cur = "0";
    let acc: number | null = null;
    let op = "";
    const calc = (a: number, b: number) =>
      ({ "+": a + b, "−": a - b, "×": a * b, "÷": b ? a / b : 0 })[op] ?? b;
    $(".calc-keys")?.addEventListener("click", (e) => {
      const k = (e.target as HTMLElement).closest<HTMLElement>("[data-k]")?.dataset.k;
      if (!k || !out) return;
      if (/\d/.test(k)) cur = cur === "0" || cur === "" ? k : (cur + k).slice(0, 12);
      else if (k === "C") [cur, acc, op] = ["0", null, ""];
      else {
        if (cur !== "") acc = acc === null ? Number(cur) : calc(acc, Number(cur));
        op = k === "=" ? "" : k;
        cur = k === "=" ? String(Math.round((acc ?? 0) * 1e6) / 1e6) : "";
        if (k === "=") acc = null;
      }
      out.textContent = cur || String(acc ?? 0);
    });

    // Code copy
    const copyCode = $<HTMLButtonElement>("[data-copy-code]");
    copyCode?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText($("[data-code]")?.textContent ?? "");
        copyCode.textContent = "Copied";
      } catch {
        copyCode.textContent = "Copy failed";
      }
      setTimeout(() => (copyCode.textContent = "Copy"), 1600);
    });

    // PDF pages
    let page = 0;
    const pdfPages = $$("[data-page]");
    for (const b of $$<HTMLButtonElement>("[data-pdf]"))
      b.addEventListener("click", () => {
        page = Math.min(pdfPages.length - 1, Math.max(0, page + Number(b.dataset.pdf)));
        pdfPages.forEach((p, i) => (p.hidden = i !== page));
        const n = $("[data-pdf-n]");
        if (n) n.textContent = `Page ${page + 1} of ${pdfPages.length}`;
      });

    // Live data: one store, two panes
    const votes = $$("[data-count]").slice(0, 3).map((c) => Number(c.textContent));
    const note = $("[data-live-note]");
    for (const b of $$<HTMLButtonElement>("[data-vote]"))
      b.addEventListener("click", () => {
        const i = Number(b.dataset.vote);
        votes[i]++;
        for (const c of $$(`[data-count="${i}"]`)) c.textContent = String(votes[i]);
        for (const bar of $$(`[data-bar="${i}"]`)) bar.style.setProperty("--n", String(votes[i]));
        if (note) note.textContent = `Saved. Both panes show ${votes[i]} for ${b.firstElementChild?.textContent}.`;
      });

    // Share
    const copyLink = $<HTMLButtonElement>("[data-copy-link]");
    copyLink?.addEventListener("click", () => {
      copyLink.textContent = "Link copied";
      setTimeout(() => (copyLink.textContent = "Copy link"), 1600);
    });
  }
</script>
