---
// Hero demo: an agent publishes over MCP, the artifact lands in the viewer,
// and gets shared. The stage is decorative (aria-hidden); the caption below
// carries the same story as real text. With no JS or reduced motion, the
// markup as written is the final frame.
const agents = ["Claude Code", "Codex", "Cursor", "OpenCode"];
const ask = "write up the Q4 data migration plan and share it with my team";
// Escapes keep the source ASCII; the build writes UTF-8 (see glyphs.test.ts).
const PROMPT = "›";
const CHECK = "✓";
const DOT = "·";
const rows = [
  ["Freeze writes", "Oct 28", "done"],
  ["Backfill R2", "Nov 4", "next"],
  ["Cutover", "Nov 18", ""],
];
---

<figure class="desk" aria-label="How it works" data-desk data-agents={agents.join(",")}>
  <div class="desk-stage" aria-hidden="true">
    <div class="desk-chat">
      <div class="desk-bar">
        <span class="desk-dot"></span>
        <span data-agent>{agents[0]}</span>
      </div>
      <div class="desk-log">
        <p class="desk-msg desk-ask">
          <span class="desk-caret">{PROMPT}</span>
          <span class="desk-type">
            <span class="desk-ghost">{ask}</span>
            <span class="desk-typed" data-typed>{ask}</span>
          </span>
        </p>
        <p class="desk-msg desk-tool" data-at="2">
          <span class="mono">publish_artifact</span>
          <span class="desk-run">running</span>
          <span class="desk-ok">{CHECK}</span>
        </p>
        <p class="desk-msg desk-reply" data-at="4">
          Published v1 {DOT} shared with Team {DOT} link copied
        </p>
      </div>
      <div class="desk-input">Message <span data-agent>{agents[0]}</span></div>
    </div>

    <div class="desk-view">
      <div class="desk-bar">
        <span class="desk-title">Q4 data migration plan</span>
        <span class="desk-ver">v1</span>
        <span class="desk-share">Share</span>
      </div>
      <div class="desk-art" data-at="3">
        <p class="desk-h">Q4 data migration plan</p>
        <p class="desk-sub">Markdown {DOT} by <span data-agent>{agents[0]}</span></p>
        <ul class="desk-rows">
          {
            rows.map(([step, date, state]) => (
              <li>
                <span>{step}</span>
                <span class="mono">{date}</span>
                <span class:list={["desk-pill", state]}>{state === "done" ? CHECK : state}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="desk-pop" data-at="4">
        <span class="mono">artifacts.example.com/a/7Hq3&hellip;</span>
        <span class="badge team">Team</span>
      </div>
    </div>
  </div>

  <figcaption class="desk-cap">
    <ol>
      <li data-phase="1"><b>Ask any AI agent.</b> Claude Code, Codex, Cursor or OpenCode.</li>
      <li data-phase="3"><b>It publishes.</b> The artifact opens in your viewer as v1.</li>
      <li data-phase="4"><b>Share the link.</b> With your team, by email, or in public.</li>
    </ol>
    <button class="desk-toggle" type="button" data-toggle hidden>
      Pause animation
    </button>
  </figcaption>
</figure>

<style>
  .desk {
    margin: 24px 0 0;
  }
  .desk-stage {
    display: grid;
    gap: 16px;
    padding: 16px;
    background: var(--oa-chrome);
    border-radius: var(--oa-radius-lg);
    box-shadow: var(--oa-shadow-1);
    font-size: var(--oa-text-sm);
  }
  @media (min-width: 760px) {
    .desk-stage {
      grid-template-columns: 5fr 7fr;
      gap: 20px;
      padding: 24px;
    }
  }
  .desk-chat,
  .desk-view {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--oa-surface);
    border-radius: var(--oa-radius-lg);
    box-shadow: var(--oa-shadow-1);
    overflow: hidden;
  }
  .desk-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border-bottom: 1px solid var(--oa-divider);
    color: var(--oa-text-2);
    font-weight: 500;
  }
  .desk-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--oa-success);
  }
  .desk-log {
    display: grid;
    align-content: start;
    gap: 10px;
    flex: 1;
    padding: 12px;
  }
  .desk-input {
    display: none;
    margin: 0 12px 12px;
    padding: 8px 10px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
    color: var(--oa-text-muted);
  }
  @media (min-width: 760px) {
    .desk-input {
      display: block;
    }
  }
  .desk-msg {
    line-height: 1.45;
  }
  .desk-ask {
    display: flex;
    gap: 8px;
    padding: 8px 10px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-sunken);
    font-family: var(--oa-font-mono);
  }
  .desk-caret {
    color: var(--oa-text-muted);
  }
  /* The ghost holds the full text's size; the typed copy overlays it. */
  .desk-type {
    position: relative;
  }
  .desk-ghost {
    visibility: hidden;
  }
  .desk-typed {
    position: absolute;
    inset: 0;
  }
  .desk-tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    padding: 4px 8px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
  }
  .desk-run {
    display: none;
    color: var(--oa-text-muted);
  }
  .desk-ok {
    color: var(--oa-success-fg);
    font-weight: 600;
  }
  .desk-reply {
    color: var(--oa-text-2);
  }
  .desk-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--oa-text);
  }
  .desk-ver {
    color: var(--oa-text-muted);
    font: 500 var(--oa-text-xs) var(--oa-font-mono);
  }
  .desk-share {
    padding: 3px 10px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-text);
    color: var(--oa-surface);
    font-size: var(--oa-text-xs);
  }
  .desk-art {
    margin: 12px;
    padding: 14px 16px;
    border: 2px solid var(--oa-text);
    border-radius: var(--oa-radius-md);
  }
  .desk-h {
    font-size: var(--oa-text-lg);
    font-weight: 600;
  }
  .desk-sub {
    color: var(--oa-text-muted);
    font-size: var(--oa-text-xs);
  }
  .desk-rows {
    display: grid;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .desk-rows li {
    display: grid;
    grid-template-columns: 1fr auto 44px;
    gap: 12px;
    align-items: center;
    padding: 6px 0;
    border-top: 1px solid var(--oa-divider);
  }
  .desk-rows .mono {
    color: var(--oa-text-muted);
    font-size: var(--oa-text-xs);
  }
  .desk-pill {
    justify-self: end;
    font-size: var(--oa-text-xs);
    color: var(--oa-text-muted);
  }
  .desk-pill.done {
    color: var(--oa-success-fg);
    font-weight: 600;
  }
  .desk-pill.next {
    padding: 1px 6px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-accent-soft);
    color: var(--oa-accent-fg);
  }
  .desk-pop {
    display: flex;
    align-items: center;
    align-self: flex-end;
    gap: 8px;
    max-width: calc(100% - 24px);
    margin: 0 12px 12px;
    padding: 8px 10px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-2);
    color: var(--oa-text-2);
    font-size: var(--oa-text-xs);
  }
  .desk-pop .mono {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Timeline: JS sets data-step; each [data-at] shows once the step reaches it.
     Only opacity and transform change, so nothing shifts. */
  [data-at] {
    transition:
      opacity 360ms var(--oa-ease),
      transform 360ms var(--oa-ease);
  }
  .desk[data-step="0"] [data-at],
  .desk[data-step="1"] [data-at],
  .desk[data-step="2"] [data-at]:not([data-at="2"]),
  .desk[data-step="3"] [data-at="4"] {
    opacity: 0;
    transform: translateY(6px);
  }
  .desk[data-step="2"] .desk-run {
    display: inline;
  }
  .desk[data-step="2"] .desk-ok {
    display: none;
  }

  .desk-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 16px;
  }
  .desk-cap ol {
    display: grid;
    gap: 6px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--oa-text-2);
    font-size: var(--oa-text-md);
  }
  @media (min-width: 760px) {
    .desk-cap ol {
      flex: 1;
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .desk-cap li {
    padding-left: 10px;
    border-left: 2px solid var(--oa-divider);
    transition: border-color var(--oa-duration) var(--oa-ease);
  }
  .desk-cap b {
    color: var(--oa-text);
    font-weight: 600;
  }
  .desk-cap li.on {
    border-color: var(--oa-accent);
  }
  .desk-toggle {
    min-height: 32px;
    padding: 0 10px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    color: var(--oa-text-2);
    font: 500 var(--oa-text-sm) var(--oa-font-sans);
    cursor: pointer;
  }
  .desk-toggle:hover {
    border-color: var(--oa-border-strong);
    color: var(--oa-text);
  }
</style>

<script>
  // Steps: 0 blank, 1 typing, 2 tool running, 3 published, 4 shared.
  const HOLD = [600, 0, 1100, 1300, 3400];
  const desk = document.querySelector<HTMLElement>("[data-desk]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  if (desk && !reduce.matches) {
    const typed = desk.querySelector<HTMLElement>("[data-typed]");
    const names = desk.querySelectorAll<HTMLElement>("[data-agent]");
    const phases = desk.querySelectorAll<HTMLElement>("[data-phase]");
    const toggle = desk.querySelector<HTMLButtonElement>("[data-toggle]");
    const agents = (desk.dataset.agents ?? "").split(",");
    const ask = typed?.textContent ?? "";
    let step = 4;
    let turn = 0;
    let chars = 0;
    let timer = 0;
    let visible = false;
    let paused = false;

    const render = () => {
      desk.dataset.step = String(step);
      if (typed) typed.textContent = step === 1 ? ask.slice(0, chars) : step === 0 ? "" : ask;
      // Phase 1 lights for steps 1-2, phase 3 for step 3, phase 4 for step 4.
      for (const p of phases) {
        const n = Number(p.dataset.phase);
        p.classList.toggle("on", n === 1 ? step === 1 || step === 2 : step === n);
      }
    };
    const tick = () => {
      if (step === 1 && chars < ask.length) {
        chars += 2;
        render();
        timer = window.setTimeout(tick, 32);
        return;
      }
      step = (step + 1) % 5;
      if (step === 0) {
        turn = (turn + 1) % agents.length;
        for (const n of names) n.textContent = agents[turn];
      }
      chars = 0;
      render();
      timer = window.setTimeout(tick, HOLD[step]);
    };
    const sync = () => {
      clearTimeout(timer);
      if (toggle) toggle.textContent = paused ? "Play animation" : "Pause animation";
      if (visible && !paused && !document.hidden) timer = window.setTimeout(tick, HOLD[step]);
      else if (paused) {
        step = 4;
        render();
      }
    };

    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        paused = !paused;
        sync();
      });
    }
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      sync();
    }).observe(desk);
    document.addEventListener("visibilitychange", sync);
    reduce.addEventListener("change", () => {
      paused = reduce.matches;
      sync();
    });
    step = 0;
    render();
  }
</script>
