---
// "Set up in three steps": a vertical stepper. On wide screens a terminal
// (decorative, aria-hidden) plays each step's agent output while the matching
// step lights up. The steps are a plain ordered list, so the text is the same
// with or without JS. With no JS or reduced motion, every line shows and no
// step is singled out.
interface Props {
  prompt: string;
}

const { prompt } = Astro.props;
// Escapes keep the source ASCII; the build writes UTF-8 (see glyphs.test.ts).
const PROMPT = "›";
const CHECK = "✓";
const DOT = "·";
const lines: [step: number, who: string, text: string][] = [
  [1, PROMPT, prompt],
  [1, "agent", `read llms.txt ${DOT} cloned the latest release`],
  [1, "agent", `pnpm install ${CHECK}`],
  [2, "agent", `npx wrangler login ${DOT} waiting for you`],
  [2, "agent", `created D1, R2, KV ${DOT} deployed ${CHECK}`],
  [2, "agent", `MCP server added ${CHECK}`],
  [3, "agent", `published "Welcome" ${DOT} link ready`],
  [3, "agent", "artifacts.example.com/a/7Hq3\u2026"],
];
---

<div class="stepper" data-stepper>
  <ol class="steps">
    <li data-n="1">
      <h3>Tell your agent</h3>
      <p>
        Your agent reads llms.txt, checks the prerequisites, clones the latest release, and runs pnpm
        install.
      </p>
      <span class="step-chip mono" aria-hidden="true"><span class="caret">{PROMPT}</span> {prompt}</span>
    </li>
    <li data-n="2">
      <h3>Sign in to Cloudflare</h3>
      <p>
        One step needs you: <code>npx wrangler login</code>. Setup then creates D1, R2 and KV and the
        Access sign-in app, deploys to both domains, and adds the MCP server to your agent.
      </p>
      <span class="step-chip" aria-hidden="true">
        Allow Wrangler to manage your account? <span class="mini-btn">Allow</span>
      </span>
    </li>
    <li data-n="3">
      <h3>Publish and share</h3>
      <p>
        Your agent publishes a Welcome artifact and gives you the link. Later, ask it to write up the Q4
        data migration plan and share it with a teammate.
      </p>
      <span class="step-chip" aria-hidden="true">
        <span class="mono">artifacts.example.com/a/7Hq3…</span>
        <span class="badge team">Team</span>
      </span>
    </li>
  </ol>

  <div class="term-col">
    <div class="term" aria-hidden="true">
      {
        lines.map(([step, who, text], i) => (
          <p data-at={step} style={`--i:${i % 3}`}>
            <b>{who}</b> {text}
          </p>
        ))
      }
    </div>
    <button class="step-toggle" type="button" data-toggle hidden>Pause animation</button>
  </div>
</div>

<style>
  .stepper {
    display: grid;
    gap: 24px;
    margin-top: 24px;
  }
  @media (min-width: 860px) {
    .stepper {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 48px;
      align-items: start;
    }
  }
  .steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  /* The rail: numbers joined by a line, one step under the next. */
  .steps li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 0 24px 36px;
    counter-increment: step;
  }
  .steps li:last-child {
    padding-bottom: 0;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 1px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--oa-text);
    color: var(--oa-surface);
    font: 500 var(--oa-text-xs) / 1 var(--oa-font-mono);
    transition: background var(--oa-duration) var(--oa-ease);
  }
  .steps li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 10px;
    top: 28px;
    bottom: 4px;
    width: 2px;
    background: var(--oa-divider);
  }
  .steps p {
    margin-top: 6px;
    color: var(--oa-text-2);
    max-width: 48ch;
  }
  .steps p code {
    font-size: 0.9em;
    color: var(--oa-text);
  }
  /* The active step: an accent number. Text keeps full contrast. */
  .stepper[data-step] li::before {
    background: var(--oa-text-muted);
  }
  .stepper[data-step="1"] li[data-n="1"]::before,
  .stepper[data-step="2"] li[data-n="2"]::before,
  .stepper[data-step="3"] li[data-n="3"]::before {
    background: var(--oa-accent);
    color: var(--oa-accent-text);
  }
  .step-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    margin-top: 10px;
    padding: 6px 10px;
    background: var(--oa-surface);
    border-radius: var(--oa-radius-md);
    box-shadow: var(--oa-shadow-1);
    color: var(--oa-text-2);
    font-size: var(--oa-text-sm);
    overflow-wrap: anywhere;
  }
  .caret {
    color: var(--oa-text-muted);
  }
  .mini-btn {
    flex: none;
    padding: 2px 8px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-text);
    color: var(--oa-surface);
    font-weight: 500;
  }

  /* Phones get the compact rail with chips; the terminal is for wide screens. */
  .term-col {
    display: none;
  }
  @media (min-width: 860px) {
    .step-chip {
      display: none;
    }
    .term-col {
      display: grid;
      gap: 12px;
      justify-items: start;
    }
  }
  .term {
    align-self: stretch;
    padding: 16px 18px;
    border-radius: var(--oa-radius-lg);
    background: #15181c;
    box-shadow: var(--oa-shadow-1);
    color: #b7bdc6;
    font: var(--oa-text-sm) / 1.9 var(--oa-font-mono);
  }
  .term p {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: opacity 280ms var(--oa-ease) calc(var(--i) * 260ms);
  }
  .term b {
    color: #7f9cff;
    font-weight: 500;
  }
  /* Lines of later steps wait; earlier steps stay printed. */
  .stepper[data-step="0"] [data-at],
  .stepper[data-step="1"] [data-at="2"],
  .stepper[data-step="1"] [data-at="3"],
  .stepper[data-step="2"] [data-at="3"] {
    opacity: 0;
    transition: none;
  }
  .step-toggle {
    min-height: 32px;
    padding: 0 10px;
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    color: var(--oa-text-2);
    font: 500 var(--oa-text-sm) var(--oa-font-sans);
    cursor: pointer;
  }
  .step-toggle:hover {
    border-color: var(--oa-border-strong);
    color: var(--oa-text);
  }
</style>

<script>
  // Plays only where the terminal shows; phones keep the static rail.
  const HOLD = [500, 2600, 2600, 3600];
  const box = document.querySelector<HTMLElement>("[data-stepper]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const wide = matchMedia("(min-width: 860px)");
  const toggle = box?.querySelector<HTMLButtonElement>("[data-toggle]");
  if (box && toggle) {
    let step = 0;
    let timer = 0;
    let visible = false;
    let paused = false;

    const render = () => {
      if (paused || reduce.matches || !wide.matches) delete box.dataset.step;
      else box.dataset.step = String(step);
      toggle.textContent = paused ? "Play animation" : "Pause animation";
      toggle.hidden = reduce.matches;
    };
    const tick = () => {
      step = (step + 1) % 4;
      render();
      timer = window.setTimeout(tick, HOLD[step]);
    };
    const sync = () => {
      clearTimeout(timer);
      if (visible && !paused && !reduce.matches && wide.matches && !document.hidden)
        timer = window.setTimeout(tick, HOLD[step]);
      else step = 0;
      render();
    };

    toggle.addEventListener("click", () => {
      paused = !paused;
      sync();
    });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      sync();
    }).observe(box);
    document.addEventListener("visibilitychange", sync);
    reduce.addEventListener("change", sync);
    wide.addEventListener("change", sync);
  }
</script>
