---
// A D4 mockup screenshot that follows the viewer's color scheme.
// TODO(FE): swap for real dashboard screenshots once FE ships them.
interface Props {
  name: string;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { name, alt, sizes, eager = false } = Astro.props;
const srcset = (theme: string) =>
  [800, 1280, 2560]
    .map((w) => `/shots/${name}-${theme}-${w}.webp ${w}w`)
    .join(", ");
---

<picture>
  <source media="(prefers-color-scheme: dark)" srcset={srcset("dark")} sizes={sizes} />
  <img
    src={`/shots/${name}-light-1280.webp`}
    srcset={srcset("light")}
    sizes={sizes}
    width="1280"
    height="800"
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
    fetchpriority={eager ? "high" : "auto"}
  />
</picture>
