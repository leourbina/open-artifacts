---
// One artifact in the gallery: the real artifact (slot) between a title bar and
// its library metadata. The viewer dialog borrows the artifact and the version
// list while it is open, so state survives the round trip.
export interface Version {
  v: string;
  by: string;
  note: string;
  when: string;
}
interface Props {
  title: string;
  kind: string;
  tags: string;
  slug: string;
  share: "private" | "team" | "public";
  versions: Version[];
  wide?: boolean;
}
const { title, kind, tags, slug, share, versions, wide = false } = Astro.props;
const top = versions[0];
const SHARE = { private: "Private", team: "Team", public: "Public link" };
---

<article
  class:list={["tile", { wide }]}
  data-tile
  data-tags={tags}
  data-slug={slug}
  data-title={title}
  data-agent={top.by}
  data-share={share}
>
  <header class="t-head">
    <span class="t-kind mono">{kind}</span>
    <h3 class="t-title">{title}</h3>
    <button class="t-open" type="button" data-open aria-haspopup="dialog" aria-label={`Open ${title}`}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
        ><path d="M9.5 2.5h4v4M13.5 2.5 8.5 7.5M6.5 13.5h-4v-4M2.5 13.5l5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </button>
  </header>
  <div class="t-body"><slot /></div>
  <footer class="t-meta">
    <span class="agent">{top.by}</span>
    <span data-ver>{top.v}</span>
    <span class:list={["share", share]} data-share-label>{SHARE[share]}</span>
  </footer>
  <ol class="hist" data-hist hidden>
    {
      versions.map((x) => (
        <li data-v={x.v} data-by={x.by}>
          <b>{x.v}</b>
          <span>{x.note}</span>
          <small>
            {x.by} · {x.when}
          </small>
          <button type="button" class="restore" data-restore={x.v}>
            Restore
          </button>
        </li>
      ))
    }
  </ol>
</article>
