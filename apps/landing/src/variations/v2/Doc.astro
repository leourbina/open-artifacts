---
// Figure 2: a Markdown artifact, rendered, with its source one click away.
// The view switch and the checkboxes are plain form controls: no script.
const source = [
  "# Launch checklist",
  "",
  "Take the runway calculator to the board on **Friday**.",
  "",
  "- [x] Draft the numbers with finance",
  "- [x] Publish v1 and share it with the team",
  "- [ ] Review the burn assumptions",
  "- [ ] Present on Friday",
  "",
  "| Owner | Task        | Due |",
  "| ----- | ----------- | --- |",
  "| Priya | Burn review | Thu |",
  "| Sam   | Board slide | Fri |",
  "",
  "```ts",
  "const months = cash / (burn - revenue);",
  "```",
].join("\n");
const tasks = [
  ["Draft the numbers with finance", true],
  ["Publish v1 and share it with the team", true],
  ["Review the burn assumptions", false],
  ["Present on Friday", false],
] as const;
---

<figure class="fig" id="fig-2">
  <div class="win doc">
    <div class="win-bar">
      <span class="url"><span class="lock" aria-hidden="true">●</span> artifacts.example.com/a/Lc93Pw</span>
      <fieldset class="seg">
        <legend class="sr-only">View</legend>
        <input type="radio" name="dv" id="dv-r" checked />
        <label for="dv-r">Rendered</label>
        <input type="radio" name="dv" id="dv-s" />
        <label for="dv-s">Markdown</label>
      </fieldset>
    </div>
    <article class="md">
      <h3>Launch checklist</h3>
      <p>Take the runway calculator to the board on <strong>Friday</strong>.</p>
      <ul class="tasks">
        {
          tasks.map(([t, done]) => (
            <li>
              <label>
                <input type="checkbox" checked={done} /> {t}
              </label>
            </li>
          ))
        }
      </ul>
      <div class="md-table">
        <table>
          <thead><tr><th>Owner</th><th>Task</th><th>Due</th></tr></thead>
          <tbody>
            <tr><td>Priya</td><td>Burn review</td><td>Thu</td></tr>
            <tr><td>Sam</td><td>Board slide</td><td>Fri</td></tr>
          </tbody>
        </table>
      </div>
      <pre class="md-code"><code><span class="k">const</span> months = cash / (burn - revenue);</code></pre>
    </article>
    <pre class="md-src" tabindex="0" aria-label="Markdown source"><code>{source}</code></pre>
  </div>
  <figcaption><b>Fig. 2</b> A Markdown artifact. Tick a box, or switch to the source your agent sent.</figcaption>
</figure>
