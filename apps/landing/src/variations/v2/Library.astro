---
// Figure 6: the library that collects everything in this essay. The filter is
// a radio group; CSS hides what doesn't match.
const kinds = [
  ["all", "All"],
  ["html", "Pages"],
  ["md", "Docs"],
  ["code", "Code"],
  ["pdf", "PDF"],
] as const;
const items = [
  {
    k: "html",
    tag: "HTML",
    title: "Runway calculator",
    agent: "Claude Code",
    v: 1,
    vis: "Team",
    when: "Today",
    href: "#fig-1",
  },
  {
    k: "md",
    tag: "MD",
    title: "Launch checklist",
    agent: "Cursor",
    v: 2,
    vis: "Team",
    when: "Today",
    href: "#fig-2",
  },
  {
    k: "md",
    tag: "MD",
    title: "Q4 data migration plan",
    agent: "Codex",
    v: 4,
    vis: "Team",
    when: "Wed",
    href: "#fig-3",
  },
  {
    k: "html",
    tag: "LIVE",
    title: "Friday demo: what goes first?",
    agent: "OpenCode",
    v: 1,
    vis: "Team",
    when: "Today",
    href: "#fig-5",
  },
  {
    k: "code",
    tag: "TS",
    title: "events-backfill.ts",
    agent: "Codex",
    v: 3,
    vis: "Private",
    when: "Tue",
  },
  {
    k: "pdf",
    tag: "PDF",
    title: "Board deck, October",
    agent: "Claude Code",
    v: 1,
    vis: "Public link",
    when: "Oct 2",
  },
];
---

<figure class="fig fig-wide" id="fig-6">
  <div class="win lib">
    <div class="win-bar">
      <span class="url"><span class="lock" aria-hidden="true">●</span> artifacts.example.com</span>
      <span class="pill">{items.length} artifacts</span>
    </div>
    <div class="lib-body">
      <fieldset class="seg lib-f">
        <legend class="sr-only">Filter by type</legend>
        {
          kinds.map(([k, label], i) => (
            <>
              <input type="radio" name="lib" id={`lib-${k}`} checked={i === 0} />
              <label for={`lib-${k}`}>{label}</label>
            </>
          ))
        }
      </fieldset>
      <ul class="lib-grid">
        {
          items.map((it) => (
            <li data-k={it.k}>
              <span class:list={["tile", `t-${it.k}`]} aria-hidden="true">{it.tag}</span>
              <span class="lib-main">
                {it.href ? <a href={it.href}>{it.title}</a> : <span class="lib-t">{it.title}</span>}
                <span class="lib-meta">From {it.agent} · v{it.v} · {it.when}</span>
              </span>
              <span class="pill">{it.vis}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <figcaption><b>Fig. 6</b> Everything above, in one library, with the agent that made each one. Filter it, or follow a title back to its figure.</figcaption>
</figure>
