---
// Variation 2 (Editorial scroll). Owned by one agent: keep its components, styles and
// scripts inside this folder.
import { REPO_URL } from "@oa/shared";
import Doc from "./Doc.astro";
import History from "./History.astro";
import Library from "./Library.astro";
import Poll from "./Poll.astro";
import Runway from "./Runway.astro";
import Share from "./Share.astro";
import "./v2.css";

const prompt = "set up open-artifacts.com/llms.txt";
const contents = [
  ["s1", "The answer is a page"],
  ["s2", "Docs that read like docs"],
  ["s3", "Every version, kept"],
  ["s4", "Private until you share it"],
  ["s5", "Pages that remember"],
  ["s6", "One library for all of it"],
];
---

<div class="ed">
  <header class="col mast">
    <p class="kicker">Open Artifacts</p>
    <h1>One agent’s answer, then a team’s library.</h1>
    <p class="dek">
      Any AI agent can publish what it makes to Open Artifacts. This is the story of one artifact, from a
      chat reply to something your whole team uses. Every figure on this page is the real thing, so try
      them as you read.
    </p>
    <p class="byline">Self-hosted on Cloudflare Workers · MIT licensed · Any AI agent over MCP</p>
    <nav class="toc" aria-label="Contents">
      <ol>
        {
          contents.map(([id, t], i) => (
            <li>
              <a href={`#${id}`}>
                <span class="n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                {t}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </header>

  <section aria-labelledby="s1">
    <div class="col">
      <p class="num" aria-hidden="true">01</p>
      <h2 id="s1">The answer is a page</h2>
      <p class="drop">
        Ask an agent for something you can use, and the reply usually scrolls away in a chat. Ask it to
        publish instead. It calls <code>publish_artifact</code>, and you get back a private link to a page
        that works: sliders, charts, buttons and all.
      </p>
    </div>
    <Runway />
    <div class="col">
      <aside class="note">
        <code>publish_artifact</code> takes HTML, Markdown, code or a PDF and returns a link.
      </aside>
      <p>
        The page lives on your own domain, behind your own sign-in, and it doesn’t matter which agent made
        it. Claude Code, Codex, Cursor, OpenCode or any MCP client publishes through the same tool.
      </p>
    </div>
  </section>

  <blockquote class="pull col"><p>The chat scrolls away. The artifact stays.</p></blockquote>

  <section aria-labelledby="s2">
    <div class="col">
      <p class="num" aria-hidden="true">02</p>
      <h2 id="s2">Docs that read like docs</h2>
      <p>
        Not everything is an app. Plans, notes and checklists arrive as Markdown and render the way they
        should, with headings, tables, task lists and highlighted code. Code files get syntax
        highlighting, and PDFs open in a viewer.
      </p>
    </div>
    <Doc />
  </section>

  <section aria-labelledby="s3">
    <div class="col">
      <p class="num" aria-hidden="true">03</p>
      <h2 id="s3">Every version, kept</h2>
      <p>
        Artifacts change. Each time an agent publishes to the same artifact, Open Artifacts keeps a new
        version and records which agent made it. Read any of them, see what changed, and restore an old
        one without losing the rest.
      </p>
    </div>
    <History />
    <div class="col">
      <p>
        This is how several agents share one piece of work. Cursor tightens a draft from Claude Code, Codex
        adds a number, and the history shows exactly who did what.
      </p>
    </div>
  </section>

  <section aria-labelledby="s4">
    <div class="col">
      <p class="num" aria-hidden="true">04</p>
      <h2 id="s4">Private until you share it</h2>
      <p>
        Everything starts private. When it’s ready, share it with people by email as viewer or editor, or
        make a public link that search engines leave alone. Sign-in runs through Cloudflare Access on your
        account, so you decide who gets in.
      </p>
    </div>
    <Share />
  </section>

  <section aria-labelledby="s5">
    <div class="col">
      <p class="num" aria-hidden="true">05</p>
      <h2 id="s5">Pages that remember</h2>
      <p>
        An HTML artifact can save and read shared data. That turns a page into a poll, a tracker or a
        checklist the whole team updates, with no backend to write and nothing to deploy.
      </p>
    </div>
    <Poll />
  </section>

  <section aria-labelledby="s6">
    <div class="col">
      <p class="num" aria-hidden="true">06</p>
      <h2 id="s6">One library for all of it</h2>
      <p>
        By Friday, this is what has piled up: a calculator, a checklist, a plan with four versions, a poll,
        a script and a deck. In chat they’d be scattered across sessions and tools. Here they sit in one
        searchable library, each with the agent that made it.
      </p>
    </div>
    <Library />
  </section>

  <section class="col coda" aria-labelledby="coda-h">
    <h2 id="coda-h">Run it on your own Cloudflare</h2>
    <p>
      Open Artifacts is MIT licensed and runs on your Cloudflare account and domain. Nothing passes
      through us. Setup takes one prompt and one sign-in.
    </p>
    <div class="ask" role="group" aria-labelledby="ask-l">
      <p id="ask-l" class="ask-l">Tell your agent:</p>
      <div class="ask-row">
        <code>{prompt}</code>
        <button type="button" class="btn-sm primary" data-copy={prompt}>Copy</button>
      </div>
      <p class="ask-status" role="status"></p>
    </div>
    <p class="plans">
      <span><b>Workers Free</b>, $0, fits one person.</span>
      <span><b>Workers Paid</b>, $5 a month, adds email invites for a team.</span>
    </p>
    <p class="links">
      <a href="/docs/setup/">Read the setup guide</a>
      <a href={REPO_URL}>Source on GitHub</a>
    </p>
  </section>
</div>

<script>
  import { detail, money, runway, verdict } from "./runway";

  const root = document.querySelector<HTMLElement>(".ed");
  if (root) {
    root.dataset.js = "";
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const q = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) =>
      el.querySelector<T>(s) as T;
    const qa = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [
      ...el.querySelectorAll<T>(s),
    ];
    const say = (el: Element, t: string) => {
      el.textContent = "";
      setTimeout(() => {
        el.textContent = t;
      }, 50);
    };

    // Runway calculator.
    const rw = q("[data-runway]");
    const ins = qa<HTMLInputElement>("input", rw);
    const bars = qa(".bar", rw);
    const fmt = (k: string, v: number) =>
      k === "growth" ? `${v}% a month` : k === "cash" ? money(v) : `${money(v)} a month`;
    rw.addEventListener("input", () => {
      const [c, b, r, g] = ins.map((i) => +i.value);
      const res = runway(c, b, r, g);
      const top = Math.max(c, ...res.series);
      for (const i of ins) q(`[data-out=${i.name}]`, rw).textContent = fmt(i.name, +i.value);
      q("[data-verdict]", rw).textContent = verdict(res);
      q("[data-detail]", rw).textContent = detail(res);
      bars.forEach((el, i) => {
        el.style.height = `${Math.max(2, (res.series[i] / top) * 100)}%`;
        el.classList.toggle("out", !!res.out && i + 1 >= res.out);
      });
    });

    // Version history: select a version, or restore one as the newest.
    const hist = q("[data-hist]");
    const vlist = q("ol", hist);
    const hstat = q("[data-hist-status]", hist);
    let latest = qa("[data-p]", hist).length;
    const pick = (v: string) => {
      for (const b of qa("[data-v]", hist)) b.setAttribute("aria-pressed", `${b.dataset.v === v}`);
      for (const p of qa("[data-p]", hist)) p.hidden = p.dataset.p !== v;
      q(`[data-p="${v}"] [data-restore]`, hist).hidden = v === `${latest}`;
    };
    hist.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLElement>("button");
      if (b?.dataset.v) pick(b.dataset.v);
      if (!b?.dataset.restore) return;
      const from = b.dataset.restore;
      const v = `${++latest}`;
      const p = q(`[data-p="${from}"]`, hist).cloneNode(true) as HTMLElement;
      p.dataset.p = v;
      for (const d of qa("del", p)) d.remove();
      for (const n of qa("ins", p)) n.replaceWith(...n.childNodes);
      q(".vmeta", p).innerHTML = `<b>v${v}</b> · You · just now · Restored from v${from}`;
      q("[data-restore]", p).dataset.restore = v;
      q(`[data-p="${from}"]`, hist).after(p);
      const li = vlist.firstElementChild?.cloneNode(true) as HTMLElement;
      const nb = q("button", li);
      nb.dataset.v = v;
      q(".vn", nb).textContent = `v${v}`;
      q(".va", nb).textContent = "You";
      q(".vw", nb).textContent = "just now";
      vlist.prepend(li);
      pick(v);
      nb.focus();
      say(hstat, `Restored v${from} as v${v}, the newest version.`);
    });

    // Share: invite by email, copy links.
    const share = q("[data-share]");
    const sstat = q("[data-share-status]", share);
    const form = q<HTMLFormElement>("[data-invite]", share);
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = q<HTMLInputElement>("input", form);
      const email = input.value.trim();
      if (!input.checkValidity() || !email) return say(sstat, "Enter an email address to invite.");
      const li = q("[data-people] li:last-child", share).cloneNode(true) as HTMLElement;
      q(".av", li).textContent = email[0].toUpperCase();
      q(".who", li).textContent = email;
      const sel = q<HTMLSelectElement>("select", li);
      sel.setAttribute("aria-label", `Role for ${email}`);
      sel.value = "Viewer";
      q("[data-people]", share).append(li);
      input.value = "";
      say(sstat, `Invited ${email} as a viewer.`);
    });
    for (const b of qa("[data-copy]")) {
      const label = b.textContent;
      b.addEventListener("click", async () => {
        const out = b.parentElement?.parentElement?.querySelector("[role=status]");
        try {
          await navigator.clipboard.writeText(b.dataset.copy ?? "");
          b.textContent = "Copied";
          if (out) say(out, "Copied to the clipboard.");
        } catch {
          if (out) say(out, `Copy this: ${b.dataset.copy}`);
        }
        setTimeout(() => {
          b.textContent = label;
        }, 1600);
      });
    }

    // Live poll: teammates vote while it's on screen; you can vote too.
    const poll = q("[data-poll]");
    const opts = qa("button", poll);
    const n = opts.map((b) => +(b.dataset.n ?? 0));
    const queue: [number, string][] = [
      [1, "Maya"],
      [0, "Sam"],
      [1, "Jun"],
      [2, "Ana"],
      [1, "Leo"],
      [0, "Ines"],
      [1, "Kai"],
    ];
    let mine = -1;
    let timer = 0;
    const draw = () => {
      const t = n.reduce((a, b) => a + b, 0);
      opts.forEach((b, i) => {
        q(".opt-bar", b).style.width = `${(n[i] / t) * 100}%`;
        q(".opt-n", b).textContent = `${n[i]}`;
        b.setAttribute("aria-pressed", `${i === mine}`);
      });
      q("[data-total]", poll).textContent = `${t} votes`;
    };
    const tick = () => {
      const next = queue.shift();
      if (!next) return clearInterval(timer);
      n[next[0]]++;
      q("[data-feed]", poll).textContent = `${next[1]} voted`;
      draw();
    };
    poll.addEventListener("click", (e) => {
      const b = (e.target as Element).closest("button");
      if (!b) return;
      const i = opts.indexOf(b);
      if (mine >= 0) n[mine]--;
      mine = mine === i ? -1 : i;
      if (mine >= 0) n[mine]++;
      draw();
      say(
        q("[data-poll-status]", poll),
        mine < 0 ? "Vote removed." : `You voted for ${q(".opt-l", b).textContent}.`,
      );
    });
    if (still) while (queue.length) tick();

    // Play the chat once it's in view; run the live poll only while on screen.
    const chat = q("[data-chat]");
    const io = new IntersectionObserver(
      (es) => {
        for (const e of es) {
          e.target.classList.toggle("on", e.isIntersecting);
          if (e.target === chat && e.isIntersecting) chat.classList.add("play");
          if (e.target === poll && !still) {
            clearInterval(timer);
            if (e.isIntersecting && queue.length) timer = window.setInterval(tick, 1500);
          }
        }
      },
      { threshold: 0.35 },
    );
    io.observe(chat);
    io.observe(poll);
  }
</script>
