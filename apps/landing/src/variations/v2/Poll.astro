---
// Figure 5: a live artifact. Teammates' votes arrive while it's on screen
// (paused offscreen); your own vote is a real toggle.
const options = [
  ["Runway calculator", 3],
  ["Q4 migration plan", 2],
  ["Launch checklist", 1],
] as const;
const total = options.reduce((s, [, n]) => s + n, 0);
---

<figure class="fig" id="fig-5">
  <div class="win poll" data-poll>
    <div class="win-bar">
      <span class="url"><span class="lock" aria-hidden="true">●</span> artifacts.example.com/a/Fd5nVt</span>
      <span class="pill live"><span class="pulse" aria-hidden="true"></span>Live</span>
    </div>
    <div class="poll-body">
      <h3 id="poll-h">Friday demo: what goes first?</h3>
      <ul class="opts" aria-labelledby="poll-h">
        {
          options.map(([label, n]) => (
            <li>
              <button type="button" aria-pressed="false" data-n={n}>
                <span class="opt-bar" style={`width:${(n / total) * 100}%`} aria-hidden="true" />
                <span class="opt-l">{label}</span>
                <span class="opt-n">{n}</span>
                <span class="sr-only"> votes</span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="poll-foot">
        <span data-total>{total} votes</span>
        <span class="feed" aria-hidden="true" data-feed></span>
      </p>
      <p class="sr-only" role="status" data-poll-status></p>
    </div>
  </div>
  <figcaption><b>Fig. 5</b> A page that keeps its own data. Votes from the team arrive as they happen; cast yours.</figcaption>
</figure>
