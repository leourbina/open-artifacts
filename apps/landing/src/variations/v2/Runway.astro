---
// Figure 1: the agent's answer (a chat turn) and the artifact it published, a
// working runway calculator.
import { detail, MONTHS, money, runway, verdict } from "./runway";

const fields = [
  {
    k: "cash",
    label: "Cash in the bank",
    min: 200,
    max: 3000,
    step: 100,
    value: 1200,
  },
  { k: "burn", label: "Monthly burn", min: 40, max: 400, step: 10, value: 150 },
  { k: "rev", label: "Monthly revenue", min: 0, max: 200, step: 5, value: 40 },
  { k: "growth", label: "Revenue growth", min: 0, max: 20, step: 1, value: 6 },
];
const show = (k: string, v: number) =>
  k === "growth"
    ? `${v}% a month`
    : k === "cash"
      ? money(v)
      : `${money(v)} a month`;
const r = runway(1200, 150, 40, 6);
const top = Math.max(1200, ...r.series);
---

<figure class="fig fig-wide" id="fig-1">
  <div class="pair">
    <div class="chat" data-chat>
      <p class="chat-head"><span class="dot" aria-hidden="true"></span>Claude Code</p>
      <ol class="chat-log">
        <li class="step you" style="--i:0">
          <span class="caret" aria-hidden="true">›</span>
          Build a runway calculator for Friday's board meeting and publish it as an artifact.
        </li>
        <li class="step" style="--i:1">I'll make it a small HTML page you can play with.</li>
        <li class="step tool" style="--i:2">
          <code>publish_artifact</code>
          <span class="ok">✓</span>
          <span class="tool-out">Runway calculator · HTML · v1 · private</span>
        </li>
        <li class="step" style="--i:3">
          Done. It's private to you for now:{" "}
          <a class="chat-link" href="#runway">artifacts.example.com/a/7Kq2mX</a>
        </li>
      </ol>
    </div>

    <div class="win" id="runway">
      <div class="win-bar">
        <span class="url"><span class="lock" aria-hidden="true">●</span> artifacts.example.com/a/7Kq2mX</span>
        <span class="pill">Private</span>
      </div>
      <div class="rw" data-runway role="group" aria-labelledby="rw-t">
        <h3 class="rw-title" id="rw-t">Runway calculator</h3>
        <div class="rw-fields">
          {
            fields.map((f) => (
              <label class="rw-f">
                <span class="rw-l">
                  {f.label}
                  <output data-out={f.k}>{show(f.k, f.value)}</output>
                </span>
                <input type="range" name={f.k} min={f.min} max={f.max} step={f.step} value={f.value} />
              </label>
            ))
          }
        </div>
        <div class="rw-result" role="status" aria-live="polite">
          <p class="rw-verdict" data-verdict>{verdict(r)}</p>
          <p class="rw-detail" data-detail>{detail(r)}</p>
        </div>
        <div class="rw-chart" aria-hidden="true">
          {
            r.series.map((c, i) => (
              <span
                class:list={["bar", { out: r.out && i + 1 >= r.out }]}
                style={`height:${Math.max(2, (c / top) * 100)}%`}
              />
            ))
          }
        </div>
        <p class="rw-axis" aria-hidden="true"><span>Month 1</span><span>Cash at month end</span><span>Month {MONTHS}</span></p>
      </div>
    </div>
  </div>
  <figcaption><b>Fig. 1</b> The answer is a page. Drag the sliders: this calculator is the artifact, running here as it would on your domain.</figcaption>
</figure>
