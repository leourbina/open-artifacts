---
// Variation 4 (Gallery). Owned by one agent: keep its components, styles and
// scripts inside this folder. The page is a wall of real artifacts that AI
// agents published. Each one works in its tile, and opens in a viewer with its
// link, versions and sharing.
import { REPO_URL } from "@oa/shared";
import Tile from "./Tile.astro";
import "./gallery.css";

const prompt = "set up open-artifacts.com/llms.txt";
const usd = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;

// Mortgage calculator, first frame (the script recomputes on input).
const mort = { price: 450000, down: 20, rate: 6.25, years: 30 };
const loan = mort.price * (1 - mort.down / 100);
const r = mort.rate / 1200;
const months = mort.years * 12;
const monthly = (loan * r) / (1 - (1 + r) ** -months);
const interest = monthly * months - loan;

const poll = [
  { label: "Flaky CI", n: 6 },
  { label: "Unclear specs", n: 4 },
  { label: "Waiting on review", n: 5 },
  { label: "Too many meetings", n: 2 },
];
const pollTotal = poll.reduce((s, o) => s + o.n, 0);

const weeks = [
  "Jul 28",
  "",
  "",
  "Aug 18",
  "",
  "",
  "Sep 8",
  "",
  "",
  "Sep 29",
  "",
  "Oct 13",
];
const series = {
  published: [42, 51, 48, 63, 58, 71, 77, 69, 84, 92, 88, 104],
  views: [310, 290, 402, 388, 455, 520, 498, 610, 644, 702, 690, 812],
};
const bars = (data: number[]) => {
  const max = Math.max(...data);
  return data.map((v, i) => ({
    v,
    h: Math.round((v / max) * 100),
    w: weeks[i],
  }));
};

const checklist = [
  { t: "Changelog drafted", done: true },
  { t: "Migrations tested on staging", done: true },
  { t: "Docs updated for the share panel", done: true },
  { t: "Rollback plan reviewed", done: true },
  { t: "Status page notice scheduled", done: false },
  { t: "Support team briefed", done: false },
  { t: "Announce in #releases", done: false },
];
const checked = checklist.filter((c) => c.done).length;

const code = `"""Backfill artifact sizes for rows made before v0.9."""
import os
from db import connect

BATCH = 500


def backfill(dry_run: bool = False) -> int:
    db = connect(os.environ["D1_URL"])
    fixed = 0
    while rows := db.query(
        "SELECT id, r2_key FROM artifacts WHERE size IS NULL LIMIT ?", BATCH
    ):
        for row in rows:
            size = db.r2.head(row.r2_key).size
            if not dry_run:
                db.run("UPDATE artifacts SET size = ? WHERE id = ?", size, row.id)
            fixed += 1
    return fixed


if __name__ == "__main__":
    print(f"fixed {backfill()} rows")`;

// A small Python highlighter, run at build time.
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const TOKEN =
  /("""[\s\S]*?"""|f?"[^"\n]*")|(#.*)|\b(import|from|def|while|for|in|if|not|return|is|None|True|False)\b|\b(\d+)\b|\b([a-z_]+)(?=\()/g;
const hl = code
  .split("\n")
  .map((line) => {
    const out = line.replace(TOKEN, (m, s, c, k, n) => {
      const cls = s ? "s" : c ? "c" : k ? "k" : n ? "n" : "f";
      return `\uE000${cls}\uE001${m}\uE002`;
    });
    const html = esc(out)
      .replace(/\uE000(\w)\uE001/g, '<span class="$1">')
      .replace(/\uE002/g, "</span>");
    return `<span class="ln">${html}</span>`;
  })
  .join("");
---

<div class="v4">
  <section class="wrap g-hero">
    <h1>Your agents make real things. <br />Keep every one of them.</h1>
    <p class="g-lede">
      Every tile below is a working artifact that an AI agent published to Open Artifacts. Use it
      right here, or open it to see its link, its versions and who it is shared with.
    </p>
    <div class="g-install" role="group" aria-labelledby="g-install-l">
      <span id="g-install-l" class="g-install-l">Tell any AI agent</span>
      <code class="g-prompt">{prompt}</code>
      <button class="btn primary" type="button" data-copy={prompt} hidden>Copy</button>
    </div>
  </section>

  <section class="wrap g-wall-wrap" aria-labelledby="g-wall-h">
    <div class="g-wall-top">
      <h2 id="g-wall-h">One library, everything works</h2>
      <div class="g-filters" role="group" aria-label="Filter artifacts" data-filters hidden>
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        <button type="button" data-filter="html" aria-pressed="false">Pages</button>
        <button type="button" data-filter="live" aria-pressed="false">Live data</button>
        <button type="button" data-filter="md" aria-pressed="false">Docs</button>
        <button type="button" data-filter="code" aria-pressed="false">Code</button>
        <button type="button" data-filter="pdf" aria-pressed="false">PDF</button>
      </div>
    </div>

    <div class="g-wall" data-wall>
      <Tile
        title="Publishing dashboard"
        kind="HTML"
        tags="html"
        slug="Dk4m8s"
        share="team"
        wide
        versions={[
          { v: "v5", by: "Claude Code", note: "Added a views series", when: "2h ago" },
          { v: "v4", by: "Claude Code", note: "Weekly buckets", when: "yesterday" },
          { v: "v3", by: "Cursor", note: "First chart", when: "Oct 9" },
        ]}
      >
        <div class="art dash">
          <dl class="kpis">
            <div><dt>Published</dt><dd>104 <small class="up">+18%</small></dd></div>
            <div><dt>Views</dt><dd>812 <small class="up">+18%</small></dd></div>
            <div><dt>Agents</dt><dd>5</dd></div>
          </dl>
          <div class="seg" role="radiogroup" aria-label="Series">
            <label><input type="radio" name="dash-s" value="published" checked /> Published</label>
            <label><input type="radio" name="dash-s" value="views" /> Views</label>
          </div>
          {
            (["published", "views"] as const).map((k) => (
              <figure class={`bars ${k}`}>
                <figcaption class="sr-only">
                  {k === "published" ? "Artifacts published" : "Artifact views"} per week, Jul 28 to Oct 13:{" "}
                  {series[k].join(", ")}.
                </figcaption>
                <div class="bars-plot" aria-hidden="true">
                  {bars(series[k]).map((b) => (
                    <span class="bar" style={`--h:${b.h}%`}>
                      <i>{b.v}</i>
                      <em>{b.w}</em>
                    </span>
                  ))}
                </div>
              </figure>
            ))
          }
        </div>
      </Tile>

      <Tile
        title="Sprint 41 retro poll"
        kind="HTML"
        tags="html live"
        slug="Rt7pQ2"
        share="team"
        versions={[
          { v: "v2", by: "Codex", note: "Added a fourth option", when: "35m ago" },
          { v: "v1", by: "Codex", note: "First version", when: "1h ago" },
        ]}
      >
        <div class="art poll" data-poll>
          <p class="poll-q">What slowed us down this sprint?</p>
          <div class="poll-opts">
            {
              poll.map((o) => (
                <button type="button" aria-pressed="false" data-n={o.n} style={`--p:${(o.n / pollTotal) * 100}%`}>
                  <span class="poll-l">{o.label}</span>
                  <span class="poll-n">{o.n}</span>
                </button>
              ))
            }
          </div>
          <p class="poll-f">
            <span class="live-dot" aria-hidden="true"></span>
            <span data-total>{pollTotal} votes</span> · 4 people here
          </p>
        </div>
      </Tile>

      <Tile
        title="Mortgage calculator"
        kind="HTML"
        tags="html"
        slug="7Hq3kP"
        share="private"
        versions={[
          { v: "v3", by: "Claude Code", note: "Rate as a number field", when: "3h ago" },
          { v: "v2", by: "Claude Code", note: "Interest breakdown", when: "Oct 15" },
          { v: "v1", by: "ChatGPT", note: "First version", when: "Oct 14" },
        ]}
      >
        <form class="art mort" data-mort>
          <div class="mort-out">
            <output data-o="pay">{usd(monthly)}</output><span>/mo</span>
            <div class="split" aria-hidden="true">
              <i data-o="split" style={`--p:${(loan / (loan + interest)) * 100}%`}></i>
            </div>
            <p class="mort-sub">
              Loan <b data-o="loan">{usd(loan)}</b> · interest <b data-o="int">{usd(interest)}</b>
            </p>
          </div>
          <label class="fld">
            <span>Home price <output data-o="price">{usd(mort.price)}</output></span>
            <input type="range" name="price" min="100000" max="1500000" step="5000" value={mort.price} />
          </label>
          <label class="fld">
            <span>Down payment <output data-o="down">{mort.down}%</output></span>
            <input type="range" name="down" min="0" max="50" step="1" value={mort.down} />
          </label>
          <div class="mort-row">
            <label class="fld">
              <span>Rate %</span>
              <input type="number" name="rate" min="0" max="15" step="0.125" value={mort.rate} inputmode="decimal" />
            </label>
            <fieldset class="fld term">
              <legend>Term</legend>
              <label><input type="radio" name="term" value="15" /> 15 yr</label>
              <label><input type="radio" name="term" value="30" checked /> 30 yr</label>
            </fieldset>
          </div>
        </form>
      </Tile>

      <Tile
        title="RFC 014: Build log retention"
        kind="MD"
        tags="md"
        slug="Rf14aZ"
        share="team"
        versions={[
          { v: "v4", by: "Cursor", note: "Answered review comments", when: "1d ago" },
          { v: "v3", by: "Cursor", note: "Cost table", when: "Oct 16" },
          { v: "v2", by: "Codex", note: "Alternatives section", when: "Oct 15" },
          { v: "v1", by: "Codex", note: "First draft", when: "Oct 14" },
        ]}
      >
        <article class="art doc" tabindex="0" aria-label="RFC 014, rendered Markdown">
          <h4>RFC 014: Build log retention</h4>
          <p class="doc-meta">Status: In review · Owner: Platform</p>
          <h5>Summary</h5>
          <p>
            Keep build logs for 30 days instead of forever. Older logs move to cold storage, and a
            pinned build keeps its logs for good.
          </p>
          <h5>Why</h5>
          <ul>
            <li>Log storage grew 4× this year and is now our third largest bill.</li>
            <li>Fewer than 1% of reads touch logs older than two weeks.</li>
            <li>Incident reviews pin the builds they need, so nothing is lost.</li>
          </ul>
          <h5>Options</h5>
          <table>
            <thead><tr><th>Option</th><th>Monthly cost</th><th>Reads</th></tr></thead>
            <tbody>
              <tr><td>Keep everything</td><td>$1,840</td><td>Fast</td></tr>
              <tr><td>30 days, then cold</td><td>$410</td><td>Slow after 30d</td></tr>
              <tr><td>30 days, then delete</td><td>$290</td><td>Gone</td></tr>
            </tbody>
          </table>
          <blockquote>Recommendation: 30 days, then cold storage. Pinning stays free.</blockquote>
          <h5>Rollout</h5>
          <ol>
            <li>Ship the <code>pin_build</code> flag.</li>
            <li>Backfill pins for the last 40 incidents.</li>
            <li>Turn on the 30 day lifecycle rule.</li>
          </ol>
        </article>
      </Tile>

      <Tile
        title="backfill.py"
        kind="CODE"
        tags="code"
        slug="c8Vd1Q"
        share="private"
        versions={[
          { v: "v2", by: "OpenCode", note: "Added dry_run", when: "20m ago" },
          { v: "v1", by: "OpenCode", note: "First version", when: "1h ago" },
        ]}
      >
        <div class="art code">
          <div class="code-bar">
            <span class="mono">Python · 23 lines</span>
            <button type="button" data-copy={code} hidden>Copy</button>
          </div>
          <pre tabindex="0" aria-label="backfill.py source"><code set:html={hl} /></pre>
        </div>
      </Tile>

      <Tile
        title="Pilot results.pdf"
        kind="PDF"
        tags="pdf"
        slug="Pf4nW2"
        share="public"
        versions={[{ v: "v1", by: "ChatGPT", note: "First version", when: "Oct 12" }]}
      >
        <div class="art pdf" data-pdf>
          <div class="pdf-bar">
            <button type="button" data-act="prev" aria-label="Previous page">‹</button>
            <span data-pg>1 / 2</span>
            <button type="button" data-act="next" aria-label="Next page">›</button>
            <span class="pdf-gap"></span>
            <button type="button" data-act="out" aria-label="Zoom out">−</button>
            <span data-z>100%</span>
            <button type="button" data-act="in" aria-label="Zoom in">+</button>
          </div>
          <div class="pdf-scroll" tabindex="0" aria-label="PDF pages">
            <div class="sheet">
              <p class="sh-eyebrow">Warehouse scanning pilot · Q3</p>
              <p class="sh-h">Pick errors fell 38% in six weeks</p>
              <p>
                Two Reno shifts used handheld scanners on every pick. The control shifts kept paper
                lists.
              </p>
              <table>
                <thead><tr><th></th><th>Paper</th><th>Scanners</th></tr></thead>
                <tbody>
                  <tr><td>Errors per 1k picks</td><td>8.1</td><td>5.0</td></tr>
                  <tr><td>Picks per hour</td><td>94</td><td>101</td></tr>
                  <tr><td>Training time</td><td>n/a</td><td>40 min</td></tr>
                </tbody>
              </table>
              <p class="sh-foot">Page 1 of 2</p>
            </div>
            <div class="sheet">
              <p class="sh-eyebrow">Next steps</p>
              <p class="sh-h">Roll out to all four sites by January</p>
              <ol>
                <li>Order 120 scanners (approved, $31k).</li>
                <li>Train leads first, then shifts.</li>
                <li>Report errors weekly for the first month.</li>
              </ol>
              <p class="sh-foot">Page 2 of 2</p>
            </div>
          </div>
        </div>
      </Tile>

      <Tile
        title="v2.4 launch checklist"
        kind="HTML"
        tags="html live"
        slug="Lc24xR"
        share="team"
        wide
        versions={[
          { v: "v6", by: "Claude Code", note: "Added support briefing", when: "10m ago" },
          { v: "v5", by: "Cursor", note: "Split the docs work", when: "2h ago" },
          { v: "v4", by: "Claude Code", note: "Saves checks for the team", when: "yesterday" },
        ]}
      >
        <div class="art check" data-check style={`--p:${(checked / checklist.length) * 100}%`}>
          <div class="check-top">
            <p><b data-done>{checked} of {checklist.length} done</b> · ships Thursday</p>
            <div class="check-bar" aria-hidden="true"><i></i></div>
          </div>
          <ul>
            {
              checklist.map((c) => (
                <li>
                  <label>
                    <input type="checkbox" checked={c.done} /> {c.t}
                  </label>
                </li>
              ))
            }
          </ul>
          <p class="check-f" data-saved aria-live="polite">Saved for the team · Sam checked one 4m ago</p>
        </div>
      </Tile>
    </div>
  </section>

  <section class="wrap g-close" aria-labelledby="g-close-h">
    <h2 id="g-close-h">Any AI agent can publish here.</h2>
    <p>
      Claude Code, Codex, Cursor, OpenCode, ChatGPT, or anything else that speaks MCP. Pages, docs,
      code and PDFs land in one private library on your own Cloudflare account, with every version kept.
    </p>
    <div class="g-close-row">
      <a class="btn primary" href="/docs/setup/">Set it up</a>
      <a class="btn" href={REPO_URL}>Source on GitHub</a>
    </div>
  </section>

  <dialog class="viewer" data-viewer aria-labelledby="vw-title">
    <div class="vw-bar">
      <svg class="vw-lock" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
        ><rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor"></rect><path
          d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"></path></svg
      >
      <span class="vw-url mono">artifacts.example.com/a/<b data-vw-slug></b></span>
      <button class="btn vw-copy" type="button" data-copy="" hidden>Copy link</button>
      <button class="vw-x" type="button" data-close aria-label="Close">×</button>
    </div>
    <div class="vw-main">
      <div class="vw-stage" data-vw-stage></div>
      <aside class="vw-side" aria-label="Artifact details">
        <h2 id="vw-title" data-vw-title></h2>
        <p class="vw-by"><span class="agent" data-vw-ver></span></p>
        <fieldset class="vw-share">
          <legend>Sharing</legend>
          <label><input type="radio" name="vw-share" value="private" /> Private</label>
          <label><input type="radio" name="vw-share" value="team" /> Team</label>
          <label><input type="radio" name="vw-share" value="public" /> Public link</label>
        </fieldset>
        <p class="vw-note" data-vw-note aria-live="polite"></p>
        <h3>Versions</h3>
        <div data-vw-hist></div>
        <p class="vw-note" data-vw-status aria-live="polite"></p>
      </aside>
    </div>
  </dialog>
</div>

<script>
  import "./gallery";
</script>
