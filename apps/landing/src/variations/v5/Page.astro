---
// Variation 5 (Minimal). Owned by one agent: keep its components, styles and
// scripts inside this folder.
import { REPO_URL } from "@oa/shared";

const prompt = "set up open-artifacts.com/llms.txt";

// Seed counts for the demo poll. The script adds the visitor's vote on top.
const options = [
  { id: "claude", label: "Claude Code", votes: 18 },
  { id: "codex", label: "Codex", votes: 11 },
  { id: "cursor", label: "Cursor", votes: 9 },
  { id: "opencode", label: "OpenCode", votes: 6 },
  { id: "other", label: "Something else", votes: 4 },
];
const total = options.reduce((sum, o) => sum + o.votes, 0);
const pct = (n: number) => Math.round((n / total) * 100);

const facts = [
  {
    title: "Any AI agent",
    body: "Claude Code, Codex, Cursor, OpenCode or anything that speaks MCP.",
  },
  {
    title: "Every version kept",
    body: "Each publish is a new version, with the agent that made it.",
  },
  {
    title: "Yours to run",
    body: "Private by default, on your own Cloudflare account. MIT licensed.",
  },
];
---

<section class="v5-hero wrap" aria-labelledby="v5-h">
  <div class="v5-copy">
    <h1 id="v5-h">Everything your agents make, kept in one place.</h1>
    <p class="v5-lede">
      Pages, docs, code and PDFs from any AI agent land in a private library with versions,
      sharing and live data.
    </p>

    <div class="v5-setup" role="group" aria-labelledby="v5-setup-label">
      <p id="v5-setup-label" class="v5-setup-label">Paste into any AI agent to set it up:</p>
      <div class="v5-setup-row">
        <code class="v5-prompt">{prompt}</code>
        <button class="btn primary v5-copybtn" type="button" data-v5-copy={prompt} hidden>
          Copy
        </button>
      </div>
      <p class="v5-note" role="status" aria-live="polite"></p>
    </div>
  </div>

  <figure class="v5-viewer" aria-labelledby="v5-cap">
    <figcaption id="v5-cap" class="v5-cap">A live artifact. Go ahead, vote.</figcaption>
    <div class="v5-window">
      <div class="v5-bar">
        <span class="v5-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="v5-url"><span class="v5-host">artifacts.example.com</span>/a/agent-poll</span>
      </div>
      <div class="v5-meta">
        <span class="v5-chip">From Claude Code</span>
        <span class="v5-chip v5-ver">v3</span>
        <span class="v5-live"><span class="v5-pulse" aria-hidden="true"></span>Live data</span>
      </div>

      <form class="v5-poll" data-v5-poll>
        <fieldset>
          <legend>Which agent makes most of your artifacts?</legend>
          {
            options.map((o) => (
              <label class="v5-opt" style={`--p:${pct(o.votes)}%`}>
                <input type="radio" name="agent" value={o.id} data-votes={o.votes} />
                <span class="v5-name">{o.label}</span>
                <span class="v5-num">
                  <span data-pct>{pct(o.votes)}%</span>
                  <span class="sr-only">
                    , <span data-count>{o.votes}</span> votes
                  </span>
                </span>
              </label>
            ))
          }
        </fieldset>
        <p class="v5-total">
          <span data-total>{total}</span> votes
          <span class="v5-status" data-v5-status role="status" aria-live="polite"></span>
        </p>
      </form>
    </div>
  </figure>
</section>

<section class="v5-facts wrap" aria-label="Open Artifacts at a glance">
  <ul>
    {
      facts.map((f) => (
        <li>
          <h2>{f.title}</h2>
          <p>{f.body}</p>
        </li>
      ))
    }
  </ul>
  <nav class="v5-links" aria-label="Learn more">
    <a class="btn" href="/docs/setup/">Read the docs</a>
    <a class="btn" href={REPO_URL}>View on GitHub</a>
  </nav>
</section>

<style>
  .v5-hero {
    display: grid;
    gap: 12px;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 8px;
  }
  @media (min-width: 900px) {
    .v5-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 64px;
      min-height: calc(100svh - 57px);
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }
  .v5-hero h1 {
    max-width: 16ch;
    font-size: clamp(30px, 5.4vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .v5-lede {
    max-width: 44ch;
    margin-top: 14px;
    color: var(--oa-text-2);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.5;
  }
  @media (max-width: 899px) {
    .v5-lede {
      display: none;
    }
  }

  .v5-setup {
    margin-top: 20px;
    max-width: 520px;
  }
  @media (min-width: 900px) {
    .v5-setup {
      margin-top: 36px;
    }
  }
  .v5-setup-label {
    color: var(--oa-text-muted);
    font-size: var(--oa-text-md);
  }
  .v5-setup-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding: 6px 6px 6px 12px;
    background: var(--oa-surface);
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-lg);
  }
  .v5-prompt {
    flex: 1;
    min-width: 0;
    font-size: clamp(12.5px, 1.5vw, 16px);
    font-weight: 500;
    user-select: all;
    overflow-wrap: anywhere;
  }
  .v5-copybtn {
    min-height: 36px;
    padding: 0 14px;
  }
  .v5-note {
    min-height: 1.4em;
    margin-top: 4px;
    color: var(--oa-accent-fg);
    font-size: var(--oa-text-sm);
  }

  /* The artifact viewer */
  .v5-viewer {
    margin: 0;
    min-width: 0;
  }
  .v5-cap {
    margin-bottom: 8px;
    color: var(--oa-text-muted);
    font-size: var(--oa-text-sm);
  }
  .v5-window {
    overflow: hidden;
    background: var(--oa-surface);
    border: 1px solid var(--oa-border);
    border-radius: var(--oa-radius-lg);
    box-shadow: var(--oa-shadow-2);
  }
  .v5-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--oa-chrome);
    border-bottom: 1px solid var(--oa-divider);
  }
  .v5-dots {
    display: flex;
    gap: 5px;
  }
  .v5-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--oa-border-strong);
  }
  .v5-url {
    flex: 1;
    min-width: 0;
    padding: 3px 10px;
    overflow: hidden;
    background: var(--oa-sunken);
    border-radius: var(--oa-radius-sm);
    color: var(--oa-text-muted);
    font: 400 var(--oa-text-sm) / 1.4 var(--oa-font-mono);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .v5-host {
    color: var(--oa-text-2);
  }
  .v5-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px 0;
    font-size: var(--oa-text-xs);
  }
  .v5-chip {
    padding: 2px 7px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-accent-soft);
    color: var(--oa-accent-fg);
    font-weight: 500;
  }
  .v5-ver {
    background: var(--oa-sunken);
    color: var(--oa-text-2);
    font-family: var(--oa-font-mono);
  }
  .v5-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--oa-success-fg);
    font-weight: 500;
  }
  .v5-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--oa-success);
    animation: v5-pulse 2s var(--oa-ease) infinite;
  }
  @keyframes v5-pulse {
    50% {
      opacity: 0.35;
    }
  }

  .v5-poll {
    padding: 8px 16px 14px;
  }
  .v5-poll fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .v5-poll legend {
    padding: 0;
    margin-bottom: 10px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .v5-opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    margin-top: 6px;
    padding: 0 12px;
    overflow: hidden;
    border: 1px solid var(--oa-divider);
    border-radius: var(--oa-radius-md);
    cursor: pointer;
    isolation: isolate;
  }
  .v5-opt::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    z-index: -1;
    width: var(--p);
    background: var(--oa-sunken);
    transition: width var(--oa-duration) var(--oa-ease);
  }
  .v5-opt:hover {
    border-color: var(--oa-border-strong);
  }
  .v5-opt:has(:checked) {
    border-color: var(--oa-accent);
  }
  .v5-opt:has(:checked)::before {
    background: var(--oa-accent-soft);
  }
  .v5-opt:has(:focus-visible) {
    outline: 2px solid var(--oa-focus);
    outline-offset: 2px;
  }
  .v5-opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .v5-name {
    flex: 1;
    font-size: var(--oa-text-md);
    font-weight: 500;
  }
  .v5-opt:has(:checked) .v5-name::after {
    content: " ✓";
    color: var(--oa-accent-fg);
  }
  .v5-num {
    color: var(--oa-text-2);
    font: 500 var(--oa-text-sm) / 1 var(--oa-font-mono);
    font-variant-numeric: tabular-nums;
  }
  .v5-total {
    margin-top: 10px;
    color: var(--oa-text-muted);
    font-size: var(--oa-text-sm);
  }
  .v5-status {
    margin-left: 8px;
    color: var(--oa-accent-fg);
  }

  /* Below the fold */
  .v5-facts {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--oa-divider);
  }
  .v5-facts ul {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .v5-facts ul {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
  .v5-facts h2 {
    font-size: var(--oa-text-lg);
    line-height: 1.35;
  }
  .v5-facts p {
    margin-top: 4px;
    color: var(--oa-text-2);
    font-size: var(--oa-text-md);
  }
  .v5-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  @media (prefers-reduced-motion: reduce) {
    .v5-pulse {
      animation: none;
    }
    .v5-opt::before {
      transition: none;
    }
  }
</style>

<script>
  const copy = document.querySelector<HTMLButtonElement>("[data-v5-copy]");
  const note = document.querySelector<HTMLElement>(".v5-note");
  if (copy && note) {
    copy.hidden = false;
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.v5Copy ?? "");
        copy.textContent = "Copied";
        note.textContent = "Copied. Paste it into your agent.";
        setTimeout(() => {
          copy.textContent = "Copy";
        }, 2000);
      } catch {
        note.textContent = "Copy failed. Select the text and copy it by hand.";
      }
    });
  }

  const poll = document.querySelector<HTMLFormElement>("[data-v5-poll]");
  if (poll) {
    const inputs = [...poll.querySelectorAll<HTMLInputElement>("input")];
    const status = poll.querySelector<HTMLElement>("[data-v5-status]");
    const totalEl = poll.querySelector<HTMLElement>("[data-total]");
    poll.addEventListener("submit", (e) => e.preventDefault());
    poll.addEventListener("change", () => {
      const counts = inputs.map((i) => Number(i.dataset.votes) + (i.checked ? 1 : 0));
      const total = counts.reduce((a, b) => a + b, 0);
      inputs.forEach((input, n) => {
        const pct = `${Math.round((counts[n] / total) * 100)}%`;
        const opt = input.parentElement as HTMLElement;
        opt.style.setProperty("--p", pct);
        (opt.querySelector("[data-pct]") as HTMLElement).textContent = pct;
        (opt.querySelector("[data-count]") as HTMLElement).textContent = String(counts[n]);
      });
      if (totalEl) totalEl.textContent = String(total);
      const picked = inputs.find((i) => i.checked);
      if (status && picked) {
        status.textContent = `Vote counted for ${picked.nextElementSibling?.textContent}.`;
      }
    });
  }
</script>
