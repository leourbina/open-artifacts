{
  // Committed staging config. The gitignored wrangler.jsonc is setup-generated.
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "env": {
    "staging": {
      "name": "open-artifacts-staging",
      // The Worker routes any host that is not CONTENT_HOST to the app, so a
      // workers.dev URL must never be live. Keep both off.
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      "routes": [
        { "pattern": "staging.open-artifacts.com", "custom_domain": true },
        {
          "pattern": "staging-content.open-artifacts.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "open-artifacts-staging",
          "database_id": "5155e2d4-d9bf-4900-b4ab-1febd480377a",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "open-artifacts-staging" }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "886a49c875024e8ab5262928d75f85b7" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ARTIFACT_RUNTIME", "class_name": "ArtifactRuntime" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ArtifactRuntime"] }
      ],
      // Browser Run (server-side thumbnails). Workers edit suffices to deploy.
      "browser": { "binding": "BROWSER" },
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist-assets",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "ratelimits": [
        {
          "name": "RL_ANON",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "triggers": { "crons": ["17 3 * * *"] },
      // Secrets are NOT configured here. Deploys overwrite vars, so
      // ACCESS_CLIENT_ID lives here. It is a public OIDC client id (not a
      // secret), set by the ops-staging-access workflow on 2026-10-18.
      "vars": {
        "ENVIRONMENT": "production",
        "APP_HOST": "staging.open-artifacts.com",
        "CONTENT_HOST": "staging-content.open-artifacts.com",
        "OWNER_EMAIL": "me@leourbina.com",
        "ACCESS_TEAM_DOMAIN": "leourbina.cloudflareaccess.com",
        "CF_ACCOUNT_ID": "26ac346086d4405f7a976d48747a2a75",
        "WORKER_NAME": "open-artifacts-staging",
        "OAUTH_KV_ID": "886a49c875024e8ab5262928d75f85b7",
        "ACCESS_CLIENT_ID": "e332570b66c35883120a21ccfe376f6394aa4089c08cb73c6224b96fab1da7e2"
      }
    }
  }
}
