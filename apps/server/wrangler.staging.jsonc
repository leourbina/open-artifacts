{
  // Committed staging config. The gitignored wrangler.jsonc is setup-generated.
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "env": {
    "staging": {
      "name": "open-artifacts-staging",
      "compatibility_flags": ["nodejs_compat"],
      "routes": [
        { "pattern": "staging.open-artifacts.com", "custom_domain": true },
        {
          "pattern": "staging-content.open-artifacts.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "open-artifacts-staging",
          "database_id": "5155e2d4-d9bf-4900-b4ab-1febd480377a",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "open-artifacts-staging" }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "886a49c875024e8ab5262928d75f85b7" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ARTIFACT_RUNTIME", "class_name": "ArtifactRuntime" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ArtifactRuntime"] }
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "../dashboard/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "ratelimits": [
        {
          "name": "RL_ANON",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "triggers": { "crons": ["17 3 * * *"] },
      // Secrets are NOT configured here. ACCESS_* are filled by Access setup.
      "vars": {
        "ENVIRONMENT": "production",
        "APP_HOST": "staging.open-artifacts.com",
        "CONTENT_HOST": "staging-content.open-artifacts.com",
        "OWNER_EMAIL": "me@leourbina.com",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_CLIENT_ID": ""
      }
    }
  }
}
