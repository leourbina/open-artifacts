{
  "name": "open-artifacts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run && pnpm -r --if-present test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "dev": "pnpm --parallel --filter @oa/server --filter @oa/dashboard --if-present dev",
    "oa:setup": "pnpm --filter @oa/setup start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
