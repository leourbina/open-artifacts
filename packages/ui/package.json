{
  "name": "@oa/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./shadcn": "./src/shadcn/index.ts",
    "./shadcn.css": "./src/shadcn/theme.css",
    "./brand": "./src/brand/index.ts",
    "./brand/*": "./src/brand/*"
  },
  "imports": {
    "#shadcn/components/*": "./src/shadcn/components/*.tsx",
    "#shadcn/ui/*": "./src/shadcn/ui/*.tsx",
    "#shadcn/lib/*": "./src/shadcn/lib/*.ts",
    "#shadcn/hooks/*": "./src/shadcn/hooks/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ladle": "ladle serve",
    "shadcn:add": "node scripts/shadcn-add.mjs",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
